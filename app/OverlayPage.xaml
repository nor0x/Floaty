<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Floaty"
    xmlns:icons="clr-namespace:Floaty.IconFont"
    x:Class="Floaty.OverlayPage"
    x:DataType="local:OverlayPage"
    BackgroundColor="Transparent">

    <ContentPage.Resources>
        <!-- Swapped onto AlwaysOnTopMenuItem.IconImageSource in code-behind
        (ApplyAlwaysOnTopMenuState):
             mutating FontImageSource.Glyph in place doesn't propagate to the already-realized native
             menu icon, so a fresh instance is assigned instead. -->
        <FontImageSource x:Key="AlwaysOnTopOnIcon"
            FontFamily="TablerIconsLine"
            Glyph="{x:Static icons:TablerLine.Pinned}"
            Color="{AppThemeBinding Light=#1C1C1E, Dark=White}" />
        <FontImageSource x:Key="AlwaysOnTopOffIcon"
            FontFamily="TablerIconsLine"
            Glyph="{x:Static icons:TablerLine.PinnedOff}"
            Color="{AppThemeBinding Light=#1C1C1E, Dark=White}" />

        <Style x:Key="OverlayButton" TargetType="Button">
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="BackgroundColor" Value="#CC202020" />
            <Setter Property="TextColor" Value="White" />
        </Style>
    </ContentPage.Resources>

    <!-- Whole-window layout: the ring sits in the center column. With the floating chat placement
    the
         chat panel is added at runtime into the left or right side column depending on available screen
         space (see OverlayPage.ApplyChatSide); the unused side column is collapsed to 0 so the ring stays
         flush against the window edge that the resize anchors. With the fixed placement the panel lives
         in its own window and the side columns stay empty. Everything outside the drawn pixels is
         transparent so the desktop shows through. -->
    <Grid x:Name="RootGrid"
        RowDefinitions="Auto"
        BackgroundColor="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftSpace" Width="0" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition x:Name="RightSpace" Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Ring host. Floating chat placement adds the panel in a side column at runtime. A Grid
             rather than a stack so the shutter flash can layer over the ring. -->
        <Grid Grid.Column="1"
            ZIndex="10"
            HorizontalOptions="Center"
            VerticalOptions="End">

            <!-- Draggable swim ring. Pan moves the window and rolls the ring. -->
            <Image x:Name="Ring"
                Source="ring1.png"
                Aspect="AspectFit"
                HeightRequest="148"
                WidthRequest="148"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
                <FlyoutBase.ContextFlyout>
                    <MenuFlyout>

                        <MenuFlyoutItem x:Name="DockedWindowTopMenuItem"
                            Text="Dock Window"
                            Clicked="OnDockedWindowClicked">
                            <MenuFlyoutItem.IconImageSource>
                                <FontImageSource FontFamily="TablerIconsLine"
                                    Glyph="{x:Static icons:TablerLine.DragDrop2}"
                                    Color="{AppThemeBinding Light=#1C1C1E, Dark=White}" />
                            </MenuFlyoutItem.IconImageSource>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="AlwaysOnTopMenuItem"
                            Text="Always on Top"
                            IconImageSource="{StaticResource AlwaysOnTopOnIcon}"
                            Clicked="OnAlwaysOnTopClicked" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Settings"
                            Clicked="OnSettingsClicked">
                            <MenuFlyoutItem.IconImageSource>
                                <FontImageSource FontFamily="TablerIconsLine"
                                    Glyph="{x:Static icons:TablerLine.Settings}"
                                    Color="{AppThemeBinding Light=#1C1C1E, Dark=White}" />
                            </MenuFlyoutItem.IconImageSource>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Float to taskbar"
                            Clicked="OnFloatToTaskbarClicked">
                            <MenuFlyoutItem.IconImageSource>
                                <FontImageSource FontFamily="TablerIconsLine"
                                    Glyph="{x:Static icons:TablerLine.LayoutBottombar}"
                                    Color="{AppThemeBinding Light=#1C1C1E, Dark=White}" />
                            </MenuFlyoutItem.IconImageSource>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Close Floaty"
                            Clicked="OnCloseClicked">
                            <MenuFlyoutItem.IconImageSource>
                                <FontImageSource FontFamily="TablerIconsLine"
                                    Glyph="{x:Static icons:TablerLine.CircleX}"
                                    Color="{AppThemeBinding Light=#1C1C1E, Dark=White}" />
                            </MenuFlyoutItem.IconImageSource>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </FlyoutBase.ContextFlyout>
                <Image.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnRingPanUpdated" />
                    <TapGestureRecognizer Tapped="OnRingTapped" />
                </Image.GestureRecognizers>
            </Image>

            <!-- The capture "flash frame": invisible at rest, blinks white while the shutter is shut
                 (see OverlayPage.RunShutterAsync). InputTransparent so it can never steal the ring's
                 gestures, and sized to the ring, whose bounds are what the click-through hit test
                 reads. -->
            <Ellipse x:Name="ShutterFlash"
                Fill="White"
                Opacity="0"
                IsVisible="False"
                InputTransparent="True" />
        </Grid>

    </Grid>

</ContentPage>