<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Floaty.ViewModels.Settings"
             xmlns:svc="clr-namespace:Floaty.Services"
             xmlns:views="clr-namespace:Floaty.Views.Settings"
             x:Class="Floaty.Views.Settings.VoiceInputView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="0">
        <TextBlock Classes="h" Text="Voice input" />
        <TextBlock Classes="hint"
                   Text="Transcription runs entirely on this machine. The runtime and models download on first use into ~/.floaty." />

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="When you stop speaking" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding VoiceSendModes}"
                          SelectedItem="{Binding VoiceSendMode}"
                          HorizontalAlignment="Left" MinWidth="240">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static views:SettingsFormat.EnumLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="Pause before auto-send" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding AutoSendPauseSeconds}"
                                   Minimum="0.5" Maximum="10" Increment="0.5"
                                   FormatString="0.0"
                                   Width="120" />
                    <TextBlock Text="seconds" VerticalAlignment="Center" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Speech-to-text model" FontWeight="SemiBold" />
                <TextBlock Classes="hint"
                           Text="The microphone button only appears in the chat once a downloaded model is selected." />
                <TextBlock Classes="hint" Text="{Binding SttError}"
                           IsVisible="{Binding SttError, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Available models" FontWeight="SemiBold" />
                <TextBlock Classes="hint" Text="Downloads land in ~/.floaty/models. A model must be downloaded before it can be used." />
                <ItemsControl ItemsSource="{Binding SttCatalog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsViewModel+ModelRow">
                            <Border Margin="0,0,0,6" Padding="10"
                                    CornerRadius="6"
                                    Background="{DynamicResource ThemeControlLowBrush}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Note}" Classes="hint" />
                                        <ProgressBar Minimum="0" Maximum="1"
                                                     Value="{Binding Progress}"
                                                     IsVisible="{Binding IsDownloading}"
                                                     Height="4" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Content="Use"
                                                IsVisible="{Binding CanUse}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).SelectSttCommand}"
                                                CommandParameter="{Binding Id}" />
                                        <TextBlock Text="In use" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsSelected}"
                                                   Foreground="{DynamicResource AccentColor}" />
                                        <Button Content="Download"
                                                IsVisible="{Binding CanDownload}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DownloadSttCommand}"
                                                CommandParameter="{Binding Id}" />
                                        <Button Content="Delete"
                                                IsVisible="{Binding CanDelete}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).AskDeleteSttCommand}"
                                                CommandParameter="{Binding Id}" />
                                        <Button Content="Really delete"
                                                IsVisible="{Binding ConfirmingDelete}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteSttCommand}"
                                                CommandParameter="{Binding Id}" />
                                        <Button Content="Cancel"
                                                IsVisible="{Binding ConfirmingDelete}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).CancelDestructiveCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
