<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Floaty.ViewModels.Settings"
             xmlns:svc="clr-namespace:Floaty.Services"
             xmlns:views="clr-namespace:Floaty.Views.Settings"
             x:Class="Floaty.Views.Settings.McpView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="0">
        <TextBlock Classes="h" Text="MCP servers" />
        <TextBlock Classes="hint"
                   Text="Each enabled server becomes a /name slash command that scopes a message to that server's tools." />

        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Configured servers" FontWeight="SemiBold" />
                <TextBlock Classes="hint" Text="No servers configured yet."
                           IsVisible="{Binding !McpServers.Count}" />
                <ItemsControl ItemsSource="{Binding McpServers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="svc:McpServerConfig">
                            <Border Margin="0,0,0,6" Padding="10"
                                    CornerRadius="6"
                                    Background="{DynamicResource ThemeControlLowBrush}">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Enabled}" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Command}" Classes="hint" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Remove"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteServerCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="8">
                <TextBlock Text="Add a server" FontWeight="SemiBold" />
                <TextBox PlaceholderText="Name" Text="{Binding NewServer.Name}" />
                <TextBox PlaceholderText="Command or URL" Text="{Binding NewServer.Command}" />
                <TextBox PlaceholderText="Arguments (one per line)" Text="{Binding NewServerArgs}"
                         AcceptsReturn="True" MinHeight="60" />
                <TextBox PlaceholderText="Environment (KEY=value, one per line)" Text="{Binding NewServerEnv}"
                         AcceptsReturn="True" MinHeight="60" />
                <TextBox PlaceholderText="Headers (Key: value, one per line)" Text="{Binding NewServerHeaders}"
                         AcceptsReturn="True" MinHeight="60" />
                <TextBlock Classes="hint" Foreground="#e06c6c" Text="{Binding McpError}"
                           IsVisible="{Binding McpError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Content="Add server" Command="{Binding AddMcpServerCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
