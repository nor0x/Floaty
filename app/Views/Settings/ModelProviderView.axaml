<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Floaty.ViewModels.Settings"
             xmlns:svc="clr-namespace:Floaty.Services"
             xmlns:views="clr-namespace:Floaty.Views.Settings"
             x:Class="Floaty.Views.Settings.ModelProviderView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="0">
        <TextBlock Classes="h" Text="Model provider" />
        <TextBlock Classes="sub"
                   Text="Providers hold the credentials; the roles below decide which provider and model each feature uses." />

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Providers" />
                <TextBlock Classes="hint" Text="No providers configured yet."
                           IsVisible="{Binding !Providers.Count}" />
                <ListBox ItemsSource="{Binding Providers}"
                         SelectedValue="{Binding ActiveProviderId}"
                         SelectedValueBinding="{Binding Id}"
                         ItemContainerTheme="{StaticResource RowItemTheme}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MaxHeight="180">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="svc:ProviderProfile">
                            <StackPanel Spacing="1">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding Kind}" Classes="hint" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox x:Name="PresetPicker"
                              ItemsSource="{Binding AddablePresets}"
                              DisplayMemberBinding="{Binding DisplayName}"
                              PlaceholderText="Add a provider…"
                              MinWidth="220" />
                    <Button Content="Add"
                            Command="{Binding AddPresetCommand}"
                            CommandParameter="{Binding #PresetPicker.SelectedItem}" />
                    <Button Content="Remove selected"
                            IsVisible="{Binding !ConfirmingRemoveProvider}"
                            Command="{Binding AskRemoveProviderCommand}"
                            IsEnabled="{Binding ActiveProvider, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <Button Classes="danger" Content="Really remove"
                            IsVisible="{Binding ConfirmingRemoveProvider}"
                            Command="{Binding DeleteProviderCommand}"
                            CommandParameter="{Binding ActiveProvider}" />
                    <Button Content="Cancel"
                            IsVisible="{Binding ConfirmingRemoveProvider}"
                            Command="{Binding CancelDestructiveCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding ActiveProvider, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="10" DataContext="{Binding ActiveProvider}">
                <TextBlock Classes="section" Text="Selected provider" />
                <TextBox PlaceholderText="Display name" Text="{Binding DisplayName}" />
                <TextBox PlaceholderText="Base URL" Text="{Binding BaseUrl}" />
                <TextBox PlaceholderText="API key" Text="{Binding ApiKey}" PasswordChar="•" />
                <TextBlock Classes="hint"
                           Text="Keys are stored in plain text in ~/.floaty/config.json." />

                <CheckBox IsChecked="{Binding RequestThinking}"
                          Content="Ask this provider to show its reasoning" />
                <!-- Always shown rather than gated on the checkbox: this card binds straight to the
                     ProviderProfile, which is a plain config object with no change notification, so an
                     IsVisible/IsEnabled bound to RequestThinking would never react to ticking the box. -->
                <Grid ColumnDefinitions="90,*">
                    <TextBlock Grid.Column="0" Text="Budget" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1"
                             Text="{Binding ThinkingBudgetTokens}"
                             PlaceholderText="thinking tokens" />
                </Grid>
                <TextBlock Classes="hint"
                           Text="Only Anthropic (extended thinking, budget in tokens) and OpenAI's Responses API need this asked for. Everything else that reasons — DeepSeek, Ollama, LM Studio, llama.cpp — streams it either way." />

                <!-- Gated on Kind rather than a checkbox: Kind only changes along with the DataContext,
                     so these re-evaluate even though ProviderProfile raises no change notifications. -->
                <Grid ColumnDefinitions="90,*"
                      IsVisible="{Binding Kind, Converter={x:Static views:SettingsFormat.SupportsEffort}}">
                    <TextBlock Grid.Column="0" Text="Effort" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{x:Static vm:SettingsViewModel.ReasoningEfforts}"
                              SelectedItem="{Binding ReasoningEffort}"
                              MinWidth="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static views:SettingsFormat.EnumLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="90,*"
                      IsVisible="{Binding Kind, Converter={x:Static views:SettingsFormat.SupportsVerbosity}}">
                    <TextBlock Grid.Column="0" Text="Verbosity" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1"
                              ItemsSource="{x:Static vm:SettingsViewModel.Verbosities}"
                              SelectedItem="{Binding Verbosity}"
                              MinWidth="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={x:Static views:SettingsFormat.EnumLabel}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <TextBlock Classes="hint"
                           IsVisible="{Binding Kind, Converter={x:Static views:SettingsFormat.SupportsEffort}}"
                           Text="Effort is how hard a reasoning model thinks; verbosity is how long its answer runs (OpenAI's GPT-5 family only). Default sends nothing. Maximum is xhigh on OpenAI and max on Anthropic, and Anthropic has nothing below low. A model that doesn't support a level may reject the request." />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Roles" />
                <TextBlock Classes="hint"
                           Text="Chat drives the conversation, Embedding powers memory search, Vision captions screenshots, Image draws pictures from chat (gpt-image-1, dall-e-3, gemini-2.5-flash-image), and Speech reads replies aloud (gpt-4o-mini-tts, tts-1). Leave a row blank to switch that feature off. Changing the embedding model means re-indexing (see Screen history)." />
                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Chat" VerticalAlignment="Center" />
                    <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Config.ChatRole.Model}" PlaceholderText="model id" />
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Embedding" VerticalAlignment="Center" />
                    <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Config.EmbeddingRole.Model}" PlaceholderText="model id" />
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Vision" VerticalAlignment="Center" />
                    <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Config.VisionRole.Model}" PlaceholderText="model id" />
                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Image" VerticalAlignment="Center" />
                    <TextBox  Grid.Row="3" Grid.Column="1" Text="{Binding Config.ImageRole.Model}" PlaceholderText="model id" />
                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Speech" VerticalAlignment="Center" />
                    <TextBox  Grid.Row="4" Grid.Column="1" Text="{Binding Config.SpeechRole.Model}" PlaceholderText="model id" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Voice output" />
                <TextBlock Classes="hint"
                           Text="Speaks assistant replies aloud through the Speech model while they stream. Code blocks and links are skipped. Each spoken sentence is a request to your provider." />
                <CheckBox IsChecked="{Binding VoiceOutputEnabled}"
                          Content="Speak assistant replies aloud" />
                <TextBlock Classes="hint"
                           IsVisible="{Binding !SpeechRoleAssigned}"
                           Text="Assign a Speech model above first (OpenAI, Azure OpenAI or another OpenAI-compatible provider)." />

                <Grid ColumnDefinitions="90,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Voice" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1"
                              ItemsSource="{x:Static vm:SettingsViewModel.SpeechVoices}"
                              SelectedItem="{Binding SpeechVoice}"
                              MinWidth="160" />

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Speed" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="1" Grid.Column="1"
                                   Value="{Binding SpeechSpeed}"
                                   Minimum="0.25" Maximum="4" Increment="0.05"
                                   FormatString="0.00"
                                   HorizontalAlignment="Left"
                                   Width="140" />

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Volume" VerticalAlignment="Center" />
                    <Slider Grid.Row="2" Grid.Column="1"
                            Minimum="0" Maximum="1"
                            Value="{Binding SpeechVolume}" />

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Style" VerticalAlignment="Top" Margin="0,6,0,0" />
                    <TextBox Grid.Row="3" Grid.Column="1"
                             Text="{Binding SpeechInstructions}"
                             PlaceholderText="e.g. Speak calmly and warmly, like a friendly assistant."
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="56" />
                </Grid>
                <TextBlock Classes="hint"
                           Text="Style instructions only reach the gpt-4o TTS models; tts-1 and other endpoints ignore them. Use the speaker button in the chat header to switch voice output on and off quickly." />

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Test voice"
                            Command="{Binding TestVoiceCommand}"
                            IsEnabled="{Binding !SpeechTesting}" />
                    <TextBlock Text="{Binding SpeechTestStatus}"
                               Classes="hint"
                               VerticalAlignment="Center"
                               TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="On-device embedding models" />
                <TextBlock Classes="hint" Text="Run locally through ONNX Runtime, so memory and screen history work with no cloud key. Changing the embedding model means re-indexing (see Screen history)." />
                <ItemsControl ItemsSource="{Binding EmbeddingCatalog}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsViewModel+ModelRow">
                            <Border Classes="row">
                                <Grid ColumnDefinitions="*,Auto">
                                    <StackPanel Grid.Column="0" Spacing="2">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Note}" Classes="hint" />
                                        <ProgressBar Minimum="0" Maximum="1"
                                                     Value="{Binding Progress}"
                                                     IsVisible="{Binding IsDownloading}"
                                                     Height="4" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                                VerticalAlignment="Center">
                                        <Button Content="Download"
                                                IsVisible="{Binding CanDownload}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DownloadEmbeddingCommand}"
                                                CommandParameter="{Binding Id}" />
                                        <Button Content="Delete"
                                                IsVisible="{Binding CanDelete}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).AskDeleteEmbeddingCommand}"
                                                CommandParameter="{Binding Id}" />
                                        <Button Classes="danger" Content="Really delete"
                                                IsVisible="{Binding ConfirmingDelete}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).DeleteEmbeddingCommand}"
                                                CommandParameter="{Binding Id}" />
                                        <Button Content="Cancel"
                                                IsVisible="{Binding ConfirmingDelete}"
                                                Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).CancelDestructiveCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>
