<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Floaty.ViewModels.Settings"
             xmlns:svc="clr-namespace:Floaty.Services"
             xmlns:views="clr-namespace:Floaty.Views.Settings"
             x:Class="Floaty.Views.Settings.BehaviorView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="0">
        <TextBlock Classes="h" Text="Behavior" />
        <TextBlock Classes="sub" Text="Startup, and what gets written to memory without being asked." />

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Start with Windows" />
                <ComboBox ItemsSource="{Binding AutostartModes}"
                          SelectedItem="{Binding AutostartMode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static views:SettingsFormat.EnumLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="hint"
                           Text="Writes an entry under HKCU Run. 'Minimized' starts Floaty hidden in the tray." />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Memory" />
                <CheckBox IsChecked="{Binding RememberTaggedCaptures}"
                          Content="Remember windows attached with @" />
                <TextBlock Classes="hint"
                           Text="A window you tag with @ is captured for the prompt either way; this decides whether it is also embedded into memory." />
                <CheckBox IsChecked="{Binding RememberDroppedFiles}"
                          Content="Remember dropped files" />
                <TextBlock Classes="hint"
                           Text="The default for the per-file toggle on each attachment chip." />
                <CheckBox IsChecked="{Binding AttachSelectionOnSummon}"
                          Content="Attach the selected text when summoning with Alt+F" />
                <TextBlock Classes="hint"
                           Text="Reads the selection from the app you were in at the moment the hotkey fired." />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Chat placement" />
                <ComboBox ItemsSource="{Binding ChatPlacements}"
                          SelectedItem="{Binding ChatPanelPlacement}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static views:SettingsFormat.EnumLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="hint"
                           Text="Floating glues the chat to the ring; Fixed gives it its own window you can place anywhere." />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="section" Text="System prompt" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Content="Restore default"
                            Command="{Binding RestoreSystemPromptCommand}" />
                </Grid>
                <TextBlock Classes="hint" Text="Stored as ~/.floaty/floaty.md. Leave empty to use Floaty's default." />
                <TextBox Text="{Binding SystemPrompt}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         MinHeight="150"
                         MaxHeight="260" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
