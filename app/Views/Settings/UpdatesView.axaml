<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Floaty.ViewModels.Settings"
             xmlns:svc="clr-namespace:Floaty.Services"
             xmlns:views="clr-namespace:Floaty.Views.Settings"
             x:Class="Floaty.Views.Settings.UpdatesView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="0">
        <TextBlock Classes="h" Text="Updates" />
        <TextBlock Classes="sub" Text="Floaty updates itself from its GitHub releases when installed." />

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Text="{Binding CurrentVersion, StringFormat=Current version: {0}}" />
                <TextBlock Classes="hint" Text="Updates are only available in an installed build."
                           IsVisible="{Binding !UpdatesSupported}" />

                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding UpdatesSupported}">
                    <Button Content="Check for updates"
                            Command="{Binding CheckUpdatesCommand}"
                            IsEnabled="{Binding !Checking}" />
                    <Button Content="Download"
                            Command="{Binding DownloadUpdateNowCommand}"
                            IsVisible="{Binding UpdateAvailable}"
                            IsEnabled="{Binding !Downloading}" />
                    <Button Content="Restart and update"
                            Command="{Binding ApplyUpdateCommand}"
                            IsVisible="{Binding UpdatePending}" />
                    <Button Content="Release notes" Command="{Binding OpenReleasesCommand}" />
                </StackPanel>

                <TextBlock Classes="hint" Text="{Binding UpdateStatus}"
                           IsVisible="{Binding UpdateStatus, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <ProgressBar Minimum="0" Maximum="100" Value="{Binding DownloadProgress}"
                             IsVisible="{Binding Downloading}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
