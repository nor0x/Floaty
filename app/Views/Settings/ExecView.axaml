<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Floaty.ViewModels.Settings"
             xmlns:svc="clr-namespace:Floaty.Services"
             xmlns:views="clr-namespace:Floaty.Views.Settings"
             xmlns:icons="clr-namespace:Floaty.IconFont"
             x:Class="Floaty.Views.Settings.ExecView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="0">
        <TextBlock Classes="h" Text="Shell" />
        <TextBlock Classes="sub"
                   Text="Lets the model propose shell commands. Off by default: a command runs with your account's full privileges." />

        <Border Classes="card">
            <StackPanel Spacing="10">
                <CheckBox IsChecked="{Binding ExecEnabled}" Content="Allow the assistant to run shell commands" />
                <TextBlock Classes="section" Text="Approval" />
                <ComboBox ItemsSource="{Binding ExecApprovalModes}"
                          SelectedItem="{Binding ExecApprovalMode}"
                          IsEnabled="{Binding ExecEnabled}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static views:SettingsFormat.EnumLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="hint"
                           Text="Prompting shows the command in the chat and waits for you. Automatic runs it immediately. &quot;Always allow&quot; on a command in the chat switches this to automatic." />
                <!-- The undo for "Always allow": back to asking before every command, saved at once. -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsExecAutoApproved}">
                    <TextBlock Grid.Column="0"
                               Classes="hint"
                               VerticalAlignment="Center"
                               Text="Commands currently run without asking. Every command still shows up in the chat." />
                    <Button Grid.Column="1"
                            Margin="10,0,0,0"
                            Command="{Binding RevokeExecAutoApprovalCommand}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{x:Static icons:TablerLine.ShieldOff}"
                                       FontFamily="{StaticResource TablerIcons}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Revoke" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Shell" />
                <ComboBox ItemsSource="{Binding ExecShells}"
                          SelectedItem="{Binding ExecShell}"
                          IsEnabled="{Binding ExecEnabled}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static views:SettingsFormat.EnumLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox PlaceholderText="Custom shell executable" Text="{Binding ExecCustomShellPath}"
                         IsEnabled="{Binding ExecEnabled}" />
                <TextBox PlaceholderText="Custom shell arguments" Text="{Binding ExecCustomShellArgs}"
                         IsEnabled="{Binding ExecEnabled}" />
                <TextBlock Classes="hint" Text="Only used when the shell is set to Custom." />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
