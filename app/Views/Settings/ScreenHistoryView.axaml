<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Floaty.ViewModels.Settings"
             xmlns:svc="clr-namespace:Floaty.Services"
             xmlns:views="clr-namespace:Floaty.Views.Settings"
             x:Class="Floaty.Views.Settings.ScreenHistoryView"
             x:DataType="vm:SettingsViewModel">

    <StackPanel Spacing="0">
        <TextBlock Classes="h" Text="Screen history" />
        <TextBlock Classes="sub"
                   Text="Records the window you settle on as you move between apps, so you can ask about things you saw earlier." />

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Mode" />
                <ComboBox ItemsSource="{Binding ScreenHistoryModes}"
                          SelectedItem="{Binding ScreenHistoryMode}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={x:Static views:SettingsFormat.EnumLabel}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Classes="hint"
                           Text="Text only stores the window's accessibility text; Text and screenshot also saves a picture. Disabled unhooks the watcher entirely." />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Capture rules" />
                <TextBlock Classes="hint"
                           Text="Capture a specific app when it opens, a set time after it opens, or every few minutes while it's open, even in the background. Rules run even when screen history is disabled, and never capture password managers or private browser windows. You can also ask in chat: &quot;capture Notepad every time it opens&quot;." />
                <TextBlock Classes="hint" Text="No capture rules yet."
                           IsVisible="{Binding !HasCaptureRules}" />
                <ItemsControl ItemsSource="{Binding CaptureRuleRows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SettingsViewModel+CaptureRuleRow">
                            <Border Classes="row">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding Rule.Enabled, Mode=OneWay}"
                                              Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).ToggleCaptureRuleCommand}"
                                              CommandParameter="{Binding Rule}"
                                              Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Detail}" Classes="hint"
                                                   IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <Button Grid.Column="2"
                                            Content="Remove"
                                            VerticalAlignment="Center"
                                            Command="{Binding $parent[UserControl].((vm:SettingsViewModel)DataContext).RemoveCaptureRuleCommand}"
                                            CommandParameter="{Binding Rule}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="section" Text="Add a rule" Margin="0,6,0,0" />
                <TextBox PlaceholderText="App or window (e.g. notepad, devenv, Visual Studio)"
                         Text="{Binding NewRuleMatch}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <ComboBox ItemsSource="{Binding CaptureRuleTriggerLabels}"
                              SelectedIndex="{Binding NewRuleTriggerIndex}"
                              MinWidth="160" />
                    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding NewRuleNeedsMinutes}">
                        <NumericUpDown Value="{Binding NewRuleAmount}"
                                       Minimum="1" Maximum="{Binding NewRuleAmountMaximum}" Increment="1"
                                       FormatString="0"
                                       Width="120" />
                        <TextBlock Text="{Binding NewRuleAmountLabel}" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
                <CheckBox Content="Include a screenshot (not just the text)"
                          IsChecked="{Binding NewRuleIncludeScreenshot}" />
                <TextBlock Classes="hint" Foreground="{DynamicResource DangerBrush}" Text="{Binding CaptureRuleError}"
                           IsVisible="{Binding CaptureRuleError, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <Button Content="Add rule" Command="{Binding AddCaptureRuleCommand}" HorizontalAlignment="Left" />
                <TextBlock Classes="hint" Text="Rules take effect when you Save." />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Stored captures" />
                <TextBlock Text="{Binding AutoCaptureCount, StringFormat={}{0} automatic captures in memory}" />

                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !ConfirmClearHistory}">
                    <Button Content="Clear screen history" Command="{Binding AskClearHistoryCommand}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ConfirmClearHistory}">
                    <TextBlock Text="Delete every automatic capture?" VerticalAlignment="Center" />
                    <Button Classes="danger" Content="Delete" Command="{Binding ConfirmClearHistoryNowCommand}" />
                    <Button Content="Cancel" Command="{Binding CancelClearHistoryCommand}" />
                </StackPanel>
                <TextBlock Classes="hint" Text="Clearing…" IsVisible="{Binding ClearingHistory}" />
            </StackPanel>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="10">
                <TextBlock Classes="section" Text="Re-index" />
                <TextBlock Classes="hint"
                           Text="Re-chunks and re-embeds every saved capture. Needed after changing the embedding model, since vectors from different models are not comparable." />
                <Button Content="Re-index captures"
                        Command="{Binding ReindexCommand}"
                        IsEnabled="{Binding !Reindexing}"
                        HorizontalAlignment="Left" />
                <TextBlock Classes="hint" Text="{Binding ReindexProgressText}"
                           IsVisible="{Binding ReindexProgressText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                <TextBlock Classes="hint" Text="{Binding ReindexResult}"
                           IsVisible="{Binding ReindexResult, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
