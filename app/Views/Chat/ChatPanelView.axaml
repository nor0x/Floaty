<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Floaty"
             xmlns:svc="clr-namespace:Floaty.Services"
             xmlns:chat="clr-namespace:Floaty.Views.Chat"
             xmlns:icons="clr-namespace:Floaty.IconFont"
             x:Class="Floaty.Views.Chat.ChatPanelView"
             x:DataType="chat:ChatPanelView">

    <UserControl.Resources>
        <SolidColorBrush x:Key="PanelFill" Color="#E61C1C1E" />
        <SolidColorBrush x:Key="PanelStroke" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="Faint" Color="#22FFFFFF" />
        <SolidColorBrush x:Key="Subtle" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="Muted" Color="#CCFFFFFF" />
        <SolidColorBrush x:Key="Dim" Color="#99FFFFFF" />
        <SolidColorBrush x:Key="PopoverFill" Color="#CC151517" />

        <!-- The container behind each conversation row. It exists for the same reason as Settings'
             NavItemTheme: Fluent's stock ListBoxItem paints the selected row as a full-bleed accent
             block, which in an accent colour is by far the loudest thing in the panel. This template
             deliberately paints nothing at all - the row inside it carries every visual, driven by
             this container's pseudo-classes (see the ConversationList styles below). -->
        <ControlTheme x:Key="ConversationItemTheme" TargetType="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <ControlTemplate>
                    <ContentPresenter Name="PART_ContentPresenter"
                                      Background="Transparent"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalAlignment="Stretch" />
                </ControlTemplate>
            </Setter>
        </ControlTheme>

        <!-- Conversation switcher row (shown in the message list under /chats). Two mutually exclusive
             layouts: the "New conversation" action reads as a button - accent pill, plus icon, one line -
             while saved threads read as data. A row's visuals all live on its Border so the ListBoxItem's
             :selected / :pointerover states can drive them from outside the template; the Buttons inside
             are transparent hit targets. -->
        <DataTemplate x:Key="ConversationTemplate" DataType="local:ConversationItemVm">
            <Grid Margin="0,3">
                <StackPanel IsVisible="{Binding IsNewAction}" Spacing="0">
                    <Border x:Name="NewRow"
                            Background="{DynamicResource AccentFaintBrush}"
                            BorderBrush="{DynamicResource AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Panel>
                            <Button Classes="convOpen"
                                    Command="{Binding OpenCommand}"
                                    Padding="10,8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{x:Static icons:TablerLine.Plus}"
                                               FontFamily="{StaticResource TablerIcons}"
                                               Foreground="{DynamicResource AccentIconOnDarkColor}"
                                               FontSize="15"
                                               Width="18"
                                               TextAlignment="Center"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border Classes="selectionBar" />
                        </Panel>
                    </Border>
                    <!-- Keeps the action from reading as the first item of the list below it. -->
                    <Border Height="1" Background="#1AFFFFFF" Margin="2,8,2,0" />
                </StackPanel>

                <Border x:Name="ConvRow"
                        IsVisible="{Binding IsSavedThread}"
                        Background="#1EFFFFFF"
                        BorderBrush="Transparent"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Panel>
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Grid.Column="0"
                                    Classes="convOpen"
                                    Command="{Binding OpenCommand}"
                                    Padding="10,7">
                                <StackPanel Spacing="1">
                                    <!-- A Grid, not a StackPanel: the title needs a finite width or
                                         TextTrimming never kicks in. -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Title}"
                                                   Foreground="White"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Border Grid.Column="1"
                                                IsVisible="{Binding IsCurrent}"
                                                Background="{DynamicResource AccentSubtleBrush}"
                                                BorderBrush="{DynamicResource AccentBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="5,0"
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="Current"
                                                       Foreground="{DynamicResource AccentIconOnDarkColor}"
                                                       FontSize="9" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Foreground="{StaticResource Dim}"
                                               FontSize="11"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="1"
                                    Classes="convDelete"
                                    Command="{Binding DeleteCommand}">
                                <TextBlock Text="{x:Static icons:TablerLine.X}"
                                           FontFamily="{StaticResource TablerIcons}"
                                           FontSize="14"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                        <Border Classes="selectionBar" />
                    </Panel>
                </Border>
            </Grid>
        </DataTemplate>

        <!-- One chat bubble. Assistant answers render as markdown; the user's own messages and
             Floaty's system notes stay literal text, both because they were never markdown and
             because /recall's "[1]" source markers would otherwise be eaten by the parser. -->
        <DataTemplate x:Key="MessageTemplate" DataType="local:ChatMessageVm">
            <Border Margin="0,3"
                    Padding="10,7"
                    CornerRadius="10"
                    MaxWidth="{Binding $parent[ItemsControl].Bounds.Width}"
                    Background="{Binding IsUser, Converter={x:Static chat:ChatBrushes.BubbleFill}}"
                    HorizontalAlignment="{Binding IsUser, Converter={x:Static chat:ChatBrushes.BubbleAlign}}">
                <StackPanel Spacing="6">
                    <!-- The model's reasoning, when it showed any. Streams open, collapses to its header
                         the moment the answer starts, and stays clickable from then on. Plain text rather
                         than markdown: it is scaffolding, and reads as subordinate to the answer below. -->
                    <StackPanel IsVisible="{Binding HasReasoning}" Spacing="3">
                        <Button Classes="reason" Command="{Binding ToggleReasoningCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Text="{Binding ReasoningToggleGlyph}"
                                           FontFamily="{StaticResource TablerIcons}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ReasoningHeader}"
                                           FontSize="11"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <SelectableTextBlock Text="{Binding Reasoning}"
                                             IsVisible="{Binding IsReasoningExpanded}"
                                             Foreground="{StaticResource Dim}"
                                             FontSize="11.5"
                                             TextWrapping="Wrap"
                                             Margin="2,0,0,2" />
                    </StackPanel>

                    <!-- Literal text for user + system notes; markdown for assistant answers. -->
                    <SelectableTextBlock Text="{Binding Text}"
                                         IsVisible="{Binding RendersLiteralText}"
                                         Foreground="White"
                                         FontSize="13"
                                         TextWrapping="Wrap" />
                    <chat:MarkdownPresenter Markdown="{Binding Text}"
                                            IsVisible="{Binding RendersMarkdown}"
                                            Foreground="White" />

                    <!-- Memory sources cited for this answer. -->
                    <StackPanel IsVisible="{Binding HasCitations}" Spacing="3">
                        <TextBlock Text="Sources"
                                   Foreground="{StaticResource Dim}"
                                   FontSize="10" />
                        <ItemsControl ItemsSource="{Binding Citations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="local:CitationVm">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,1">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="{StaticResource Muted}"
                                                   FontSize="11"
                                                   MaxWidth="180"
                                                   VerticalAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <Button IsVisible="{Binding HasImage}"
                                                Command="{Binding OpenImageCommand}"
                                                Classes="pill"
                                                Content="image" />
                                        <Button IsVisible="{Binding HasText}"
                                                Command="{Binding OpenTextCommand}"
                                                Classes="pill"
                                                Content="text" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- Read this answer aloud through the speech model. Shown once the answer has
                         finished streaming and a speech model is configured (ShowReadAloud). -->
                    <Button IsVisible="{Binding ShowReadAloud}"
                            Click="OnReadAloudClicked"
                            Content="{x:Static icons:TablerLine.Volume}"
                            FontFamily="{StaticResource TablerIcons}"
                            Foreground="{StaticResource Dim}"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="22" Height="22"
                            Padding="0"
                            Margin="0,-2,-4,-4"
                            CornerRadius="6"
                            FontSize="13"
                            HorizontalAlignment="Right"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Read aloud" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Conversation rows. The row Border carries every visual, so hover and selection are driven
             from the ListBoxItem's pseudo-classes rather than from the Button inside it. Scoped to
             ConversationList by name so the slash-command popover keeps its own look. -->
        <Style Selector="ListBox#ConversationList ListBoxItem:pointerover Border#ConvRow">
            <Setter Property="Background" Value="#2EFFFFFF" />
        </Style>
        <Style Selector="ListBox#ConversationList ListBoxItem:selected Border#ConvRow">
            <Setter Property="Background" Value="#2EFFFFFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
        </Style>
        <!-- The New-conversation pill is already accent-tinted, so it deepens 9% -> 16% instead. -->
        <Style Selector="ListBox#ConversationList ListBoxItem:pointerover Border#NewRow">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        </Style>
        <Style Selector="ListBox#ConversationList ListBoxItem:selected Border#NewRow">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        </Style>

        <!-- Selection marker: a short accent bar on the leading edge of the selected row, the same
             language the Settings section rail uses. -->
        <Style Selector="Border.selectionBar">
            <Setter Property="Width" Value="3" />
            <Setter Property="Height" Value="16" />
            <Setter Property="CornerRadius" Value="1.5" />
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="ListBox#ConversationList ListBoxItem:selected Border.selectionBar">
            <Setter Property="IsVisible" Value="True" />
        </Style>

        <!-- The row's click target: invisible by design, since the Border around it is the row. -->
        <Style Selector="Button.convOpen">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.convOpen /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.convOpen:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.convOpen:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Delete a saved thread. Stays visible at rest rather than revealing on hover, so it is still
             findable by keyboard and touch; it just sits back until pointed at. -->
        <Style Selector="Button.convDelete">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.convDelete /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.convDelete:pointerover">
            <Setter Property="Foreground" Value="White" />
        </Style>
        <Style Selector="Button.convDelete:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Subtle}" />
        </Style>
        <Style Selector="Button.pill">
            <Setter Property="Background" Value="#33FFFFFF" />
            <Setter Property="Foreground" Value="#CCFFFFFF" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="FontSize" Value="10" />
        </Style>
        <!-- The reasoning disclosure header: a button only so it is keyboard- and pointer-reachable;
             visually it is just the dimmed chevron-and-label row. -->
        <Style Selector="Button.reason">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.reason:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextElement.Foreground" Value="{StaticResource Muted}" />
        </Style>
        <!-- The chat input: MAUI needed native-TextBox interop for this; here it is a style. -->
        <Style Selector="TextBox.chat">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CaretBrush" Value="White" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentColor}" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
        <Style Selector="TextBox.chat:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.chat:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </UserControl.Styles>

    <!-- Slide-out chat panel: scrollable message list above, input box at the bottom. The host places
         and sizes it; everything below here is placement-agnostic. -->
    <Border x:Name="PanelBorder"
            BorderBrush="{StaticResource PanelStroke}"
            BorderThickness="1"
            Background="{StaticResource PanelFill}"
            Padding="14,8,8,8"
            CornerRadius="10">
        <!-- Row 1 (the message list / conversation list) is the only star row, and that is what keeps
             the input row on screen. Every row here is content-sized, so with all-Auto rows a panel
             taller than the window it is arranged in loses its *last* rows - the input row and the
             status strip get pushed out of the bottom. Making the list row star means the list is
             what gives way when space is tight: it shrinks and scrolls, and the fixed chrome above
             and below it always fits. -->
        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">

            <!-- Drag bar and resize grip share the top row with non-overlapping hit areas. -->
            <Grid x:Name="TopGripRow"
                  Grid.Row="0"
                  ColumnDefinitions="Auto,*,Auto"
                  Margin="-12,-6,-12,4"
                  Height="18">

                <!-- Conversation title chip: sits opposite the resize grip. Click to edit. -->
                <Panel x:Name="ConversationTitleHost"
                       Grid.Column="0"
                       HorizontalAlignment="Left"
                       VerticalAlignment="Center"
                       Margin="4,0,0,0"
                       MaxWidth="170">
                    <!-- Foreground duplicates the label's below on purpose: it is what
                         Styles/ButtonStates.axaml derives a transparent button's hover wash from,
                         and without it the button would inherit Fluent's near-black and wash dark
                         against this panel's dark chrome. -->
                    <Button x:Name="ConversationTitleChip"
                            Click="OnConversationTitleTapped"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,2"
                            CornerRadius="6"
                            Foreground="{StaticResource Muted}">
                        <TextBlock x:Name="ConversationTitleLabel"
                                   Text="Conversation"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="10"
                                   TextTrimming="CharacterEllipsis" />
                    </Button>
                    <Border x:Name="ConversationTitleEditorBorder"
                            IsVisible="False"
                            Padding="6,2"
                            Background="Transparent"
                            CornerRadius="6">
                        <TextBox x:Name="ConversationTitleEntry"
                                 Classes="chat"
                                 FontSize="10"
                                 Padding="0"
                                 Foreground="{StaticResource Muted}"
                                 KeyDown="OnConversationTitleKeyDown"
                                 LostFocus="OnConversationTitleLostFocus" />
                    </Border>
                </Panel>

                <!-- Drag handle: only shown when the panel has its own window (fixed placement),
                     where there is no ring to drag it by. Dragging it moves the window. -->
                <Border x:Name="DragBar"
                        Grid.Column="1"
                        IsVisible="False"
                        Background="Transparent"
                        Padding="0">
                    <Border Width="38" Height="4"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Center"
                            Background="{StaticResource Subtle}"
                            CornerRadius="2" />
                </Border>

                <!-- Corner tools: the expand toggle and the resize grip. Same row as the drag bar,
                     but in a dedicated edge cell to avoid gesture overlap. ApplyPanelSide mirrors the
                     pair as a unit, keeping the grip on the panel's outermost corner. -->
                <Grid x:Name="TopCornerTools"
                      Grid.Column="2"
                      ColumnDefinitions="Auto,Auto,Auto"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top">

                    <!-- Voice output on/off. Hidden until a speech model is configured (see
                         UpdateVoiceOutputControls); flips and saves VoiceOutputEnabled directly. -->
                    <Button x:Name="SpeakerToggleButton"
                            Grid.Column="0"
                            IsVisible="False"
                            Click="OnSpeakerToggleClicked"
                            Content="{x:Static icons:TablerLine.DeviceSpeakerOff}"
                            FontFamily="{StaticResource TablerIcons}"
                            Foreground="{StaticResource Subtle}"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="26" Height="26"
                            Padding="0"
                            CornerRadius="6"
                            FontSize="14"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />

                    <!-- Expand / restore: fills the work area, or puts the previous size back. -->
                    <Button x:Name="ExpandButton"
                            Grid.Column="1"
                            Click="OnExpandToggleClicked"
                            Content="{x:Static icons:TablerLine.ArrowsMaximize}"
                            FontFamily="{StaticResource TablerIcons}"
                            Foreground="{StaticResource Subtle}"
                            Background="Transparent"
                            BorderThickness="0"
                            Width="26" Height="26"
                            Padding="0"
                            CornerRadius="6"
                            FontSize="14"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center"
                            ToolTip.Tip="Expand" />

                    <Border x:Name="ResizeCornerGrip"
                            Grid.Column="2"
                            Width="26" Height="26"
                            Background="Transparent">
                        <TextBlock x:Name="ResizeCornerGlyph"
                                   FontFamily="{StaticResource TablerIcons}"
                                   Foreground="#33FFFFFF"
                                   FontSize="20"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                </Grid>
            </Grid>

            <!-- The message list. An ItemsControl sizes to its content, so unlike the BlazorWebView it
                 replaced there is no JS ResizeObserver reporting a height back to C#, no one-pixel
                 sliver to keep the webview laying out, and no bridge object. It simply grows until
                 MaxHeight, then scrolls. -->
            <ScrollViewer x:Name="MessagesScroller"
                          Grid.Row="1"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <!-- Bottom-aligned so a short conversation in a tall (expanded or dragged) panel sits
                     just above the input row rather than stranded at the top. Ignored once the content
                     is taller than the viewport, which is when the scroller takes over. -->
                <ItemsControl x:Name="MessagesList"
                              VerticalAlignment="Bottom"
                              ItemTemplate="{StaticResource MessageTemplate}" />
            </ScrollViewer>

            <ListBox x:Name="ConversationList"
                     Grid.Row="1"
                     IsVisible="False"
                     MaxHeight="240"
                     Background="Transparent"
                     BorderThickness="0"
                     SelectionChanged="OnConversationSelectionChanged"
                     ItemContainerTheme="{StaticResource ConversationItemTheme}"
                     ItemTemplate="{StaticResource ConversationTemplate}" />

            <Border x:Name="SlashSuggestionsPanel"
                    Grid.Row="2"
                    Margin="-5,0,15,0"
                    IsVisible="False"
                    MaxHeight="132"
                    Background="{StaticResource PopoverFill}"
                    BorderBrush="{StaticResource Subtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6,4">
                <ListBox x:Name="SlashSuggestionsList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="OnSlashSuggestionsSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="chat:SlashCommand">
                            <Grid ColumnDefinitions="Auto,Auto,*" Margin="6,4">
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Icon}"
                                           FontFamily="{StaticResource TablerIcons}"
                                           Foreground="{DynamicResource AccentIconOnDarkColor}"
                                           FontSize="15"
                                           Width="18"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Token}"
                                           Foreground="White"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Margin="8,0"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Description}"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="12"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Open-window picker shown while the user types an @-mention; mutually exclusive with
                 SlashSuggestionsPanel (visibility managed in code). -->
            <Border x:Name="WindowSuggestionsPanel"
                    Grid.Row="2"
                    Margin="-5,0,15,0"
                    IsVisible="False"
                    MaxHeight="132"
                    Background="{StaticResource PopoverFill}"
                    BorderBrush="{StaticResource Subtle}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="6,4">
                <ListBox x:Name="WindowSuggestionsList"
                         Background="Transparent"
                         BorderThickness="0"
                         SelectionChanged="OnWindowSuggestionsSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="svc:WindowInfo">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="6,4">
                                <TextBlock Grid.Column="0"
                                           Text="{x:Static icons:TablerLine.AppWindow}"
                                           FontFamily="{StaticResource TablerIcons}"
                                           Foreground="{DynamicResource AccentIconOnDarkColor}"
                                           FontSize="15"
                                           Width="18"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}"
                                           Foreground="White"
                                           FontSize="13"
                                           Margin="8,0"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2"
                                           Text="{Binding ProcessName}"
                                           Foreground="{StaticResource Muted}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- Attached to the pending prompt - windows tagged with @, dropped files, and the text
                 that was selected when Floaty was summoned - shown as removable chips. Dropped files
                 also carry a toggle deciding whether they are written to memory on send. -->
            <ItemsControl x:Name="AttachmentChipsPanel"
                          Grid.Row="3"
                          IsVisible="False"
                          Margin="-6,4,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="chat:PromptAttachmentVm">
                        <Border Background="{StaticResource Subtle}"
                                Padding="8,3"
                                CornerRadius="9"
                                Opacity="{Binding ChipOpacity}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding Glyph}"
                                           FontFamily="{StaticResource TablerIcons}"
                                           Foreground="{DynamicResource AccentIconOnDarkColor}"
                                           FontSize="12"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Title}"
                                           Foreground="White"
                                           FontSize="11"
                                           MaxWidth="140"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- Per-file override of the "remember dropped files" setting. -->
                                <Button IsVisible="{Binding ShowPersistToggle}"
                                        Command="{Binding TogglePersistCommand}"
                                        Background="Transparent"
                                        Foreground="{DynamicResource AccentIconOnDarkColor}"
                                        BorderThickness="0"
                                        Padding="2,0"
                                        Opacity="{Binding PersistOpacity}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding PersistGlyph}"
                                               FontFamily="{StaticResource TablerIcons}"
                                               Foreground="{DynamicResource AccentIconOnDarkColor}"
                                               FontSize="12" />
                                </Button>
                                <Button Command="{Binding RemoveCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="0"
                                        Foreground="{StaticResource Muted}"
                                        FontSize="11"
                                        Content="✕"
                                        VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Exec approval: shown while the model waits for the user to approve a shell command
                 proposed by the exec tool. Run/Cancel complete the pending approval. -->
            <Border x:Name="ExecApprovalPanel"
                    Grid.Row="4"
                    IsVisible="False"
                    Margin="-6,4,-6,6"
                    Padding="10"
                    Background="{StaticResource Faint}"
                    BorderBrush="{StaticResource Subtle}"
                    BorderThickness="1"
                    CornerRadius="8">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{x:Static icons:TablerLine.Terminal2}"
                                   FontFamily="{StaticResource TablerIcons}"
                                   Foreground="{DynamicResource AccentIconOnDarkColor}"
                                   FontSize="13"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="ExecApprovalHeaderLabel"
                                   Text="Run this command?"
                                   Foreground="White"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <Border Background="#33000000" Padding="8,6" CornerRadius="6">
                        <SelectableTextBlock x:Name="ExecApprovalCommandLabel"
                                             Foreground="#EEFFFFFF"
                                             FontFamily="Cascadia Mono,Consolas,monospace"
                                             FontSize="12"
                                             TextWrapping="Wrap" />
                    </Border>
                    <TextBlock x:Name="ExecApprovalDirLabel"
                               IsVisible="False"
                               Foreground="{StaticResource Dim}"
                               FontSize="10" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button x:Name="ExecApprovalCancelButton"
                                Content="Cancel"
                                Click="OnExecApprovalCancelClicked"
                                Height="30"
                                Padding="12,0"
                                FontSize="12"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="{StaticResource Subtle}"
                                Foreground="White" />
                        <Button x:Name="ExecApprovalRunButton"
                                Content="Run"
                                Click="OnExecApprovalRunClicked"
                                Height="30"
                                Padding="16,0"
                                FontSize="12"
                                CornerRadius="6"
                                BorderThickness="0"
                                Background="{DynamicResource AccentColor}"
                                Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- The input row. This must never be pushed out of view, so RefreshMessageAreaHeight
                 measures it as chrome and caps the message list at whatever is left. -->
            <Grid x:Name="InputRow" Grid.Row="5" ColumnDefinitions="Auto,*,Auto" Margin="-6,0,-6,0">
                <!-- Chevron: collapse the chat panel entirely. Column + glyph are set at runtime so it
                     points toward the ring on whichever side the panel opened. -->
                <Button x:Name="CollapseButton"
                        Grid.Column="0"
                        Click="OnCollapseChatClicked"
                        Width="18"
                        Padding="0"
                        CornerRadius="0"
                        BorderThickness="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="#55FFFFFF"
                        Foreground="White">
                    <!-- The glyph is a child rather than the Button's Content so it can be centred on
                         its own box; ApplyPanelSide flips its Text, the way it flips ResizeCornerGlyph. -->
                    <TextBlock x:Name="CollapseGlyph"
                               Text="{x:Static icons:TablerLine.CaretLeft}"
                               FontFamily="{StaticResource TablerIcons}"
                               FontSize="14"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Button>
                <Border Grid.Column="1"
                        Background="{StaticResource Faint}"
                        CornerRadius="6"
                        ClipToBounds="True">
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                        <TextBox x:Name="ChatEntry"
                                 Grid.Column="0"
                                 Classes="chat"
                                 PlaceholderText="Ask Floaty…"
                                 VerticalAlignment="Center"
                                 Padding="8,0"
                                 TextChanged="OnChatEntryTextChanged"
                                 KeyDown="OnChatEntryKeyDown" />
                        <!-- Stops a reply being read aloud; only visible while voice output is playing. -->
                        <Button x:Name="StopSpeakingButton"
                                Grid.Column="1"
                                Click="OnStopSpeakingClicked"
                                Content="{x:Static icons:TablerLine.PlayerStop}"
                                FontFamily="{StaticResource TablerIcons}"
                                IsVisible="False"
                                Width="36" Height="36"
                                Padding="0"
                                CornerRadius="0"
                                BorderThickness="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="16"
                                Background="{StaticResource Subtle}"
                                Foreground="White"
                                ToolTip.Tip="Stop speaking (Esc)" />
                        <!-- Voice input: hidden until a downloaded speech-to-text model is selected
                             in settings (see UpdateMicVisibility). -->
                        <Button x:Name="MicButton"
                                Grid.Column="2"
                                Click="OnMicClicked"
                                Content="{x:Static icons:TablerLine.Microphone}"
                                FontFamily="{StaticResource TablerIcons}"
                                IsVisible="False"
                                Width="36" Height="36"
                                Padding="0"
                                CornerRadius="0"
                                BorderThickness="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="16"
                                Background="{StaticResource Subtle}"
                                Foreground="White" />
                        <Button x:Name="SendButton"
                                Grid.Column="3"
                                Click="OnSendClicked"
                                Content="{x:Static icons:TablerLine.Send}"
                                FontFamily="{StaticResource TablerIcons}"
                                Width="36" Height="36"
                                Padding="0"
                                CornerRadius="0"
                                BorderThickness="0"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                FontSize="16"
                                Background="{DynamicResource AccentColor}"
                                Foreground="White" />
                    </Grid>
                </Border>
            </Grid>

            <!-- Inline status toast under the input row. Height is animated in code so the panel
                 grows/shrinks smoothly instead of jumping. -->
            <Border x:Name="InlineToastPanel"
                    Grid.Row="6"
                    IsVisible="False"
                    Opacity="0"
                    Height="0"
                    Margin="-6,4,-6,0"
                    Padding="8,5"
                    Background="#A6141416"
                    BorderBrush="{StaticResource Subtle}"
                    BorderThickness="1"
                    CornerRadius="7">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Text="{x:Static icons:TablerLine.InfoCircle}"
                               FontFamily="{StaticResource TablerIcons}"
                               Foreground="{DynamicResource AccentIconOnDarkColor}"
                               FontSize="12"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="InlineToastLabel"
                               Foreground="#EEFFFFFF"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

        </Grid>
    </Border>

</UserControl>
