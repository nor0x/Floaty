@inject SettingsService ConfigService
@inject SkillService SkillService
@inject UpdateService UpdateService
@inject IMemoryService MemoryService
@inject ModelDownloadService ModelDownloads
@inject AiClientFactory AiClients
@inject ILocalEmbeddingFactory LocalEmbeddings
@using Floaty.Services
@implements IDisposable

<div class="settings" style="@AccentPalette.From(_config.AccentColor).ToCssVariables()">
    <header class="settings-header">
        <h1><i class="ti ti-settings" aria-hidden="true"></i> Settings</h1>
        <p class="subtitle">Configure Floaty behavior and AI provider options.</p>
    </header>

    <section class="settings-panel">
        <aside class="tabs" aria-label="Settings sections">
            <button class="tab @TabClass(SettingsSection.Behavior)"
                    @onclick="() => SelectSection(SettingsSection.Behavior)">
                <i class="ti ti-message-chatbot" aria-hidden="true"></i>
                <span>Behavior</span>
            </button>
            <button class="tab @TabClass(SettingsSection.Appearance)"
                    @onclick="() => SelectSection(SettingsSection.Appearance)">
                <i class="ti ti-palette" aria-hidden="true"></i>
                <span>Appearance</span>
            </button>
            <button class="tab @TabClass(SettingsSection.Sounds)"
                    @onclick="() => SelectSection(SettingsSection.Sounds)">
                <i class="ti ti-volume" aria-hidden="true"></i>
                <span>Sounds</span>
            </button>
            <button class="tab @TabClass(SettingsSection.ModelProvider)"
                    @onclick="() => SelectSection(SettingsSection.ModelProvider)">
                <i class="ti ti-cpu" aria-hidden="true"></i>
                <span>Model Provider</span>
            </button>
            <button class="tab @TabClass(SettingsSection.ScreenHistory)"
                    @onclick="() => SelectSection(SettingsSection.ScreenHistory)">
                <i class="ti ti-history" aria-hidden="true"></i>
                <span>Screen History</span>
            </button>
            <button class="tab @TabClass(SettingsSection.VoiceInput)"
                    @onclick="() => SelectSection(SettingsSection.VoiceInput)">
                <i class="ti ti-microphone" aria-hidden="true"></i>
                <span>Voice Input</span>
            </button>
            <button class="tab @TabClass(SettingsSection.Mcp)"
                    @onclick="() => SelectSection(SettingsSection.Mcp)">
                <i class="ti ti-server-2" aria-hidden="true"></i>
                <span>MCP Servers</span>
            </button>
            <button class="tab @TabClass(SettingsSection.Exec)"
                    @onclick="() => SelectSection(SettingsSection.Exec)">
                <i class="ti ti-terminal-2" aria-hidden="true"></i>
                <span>Shell</span>
            </button>
            <button class="tab @TabClass(SettingsSection.Skills)"
                    @onclick="() => SelectSection(SettingsSection.Skills)">
                <i class="ti ti-bolt" aria-hidden="true"></i>
                <span>Skills</span>
            </button>
            <button class="tab @TabClass(SettingsSection.Updates)"
                    @onclick="() => SelectSection(SettingsSection.Updates)">
                <i class="ti ti-cloud-download" aria-hidden="true"></i>
                <span>Updates</span>
            </button>
        </aside>

        <div class="card">
            @if (_activeSection == SettingsSection.Behavior)
            {
                <div class="card-head">
                    <h2>Behavior</h2>
                    <p>Define Floaty's system prompt used at the start of every chat, and how Floaty starts.</p>
                </div>

                <div class="field">
                    <label for="systemPrompt">System prompt</label>
                    <textarea id="systemPrompt" rows="12" autocomplete="off" spellcheck="false" @bind="_systemPrompt"
                              @bind:event="oninput"></textarea>
                    <span class="hint">Saved locally to <code>~/.floaty/floaty.md</code>.</span>
                </div>

                @if (OperatingSystem.IsWindows())
                {
                    <div class="field">
                        <label>Selected text</label>
                        <label class="hint" style="display:flex;gap:8px;align-items:center;cursor:pointer">
                            <input type="checkbox" @bind="_config.AttachSelectionOnSummon" />
                            Attach selected text when Floaty is summoned
                        </label>
                        <span class="hint">Pressing <code>Alt+F</code> brings the ring to your cursor. With this on, any
                            text you had selected comes with it as a chip on the prompt — remove the chip and it is
                            forgotten.</span>
                        <span class="hint">Apps that expose their selection to accessibility tools are read directly.
                            The rest (browsers, Electron apps, terminals) are read with a quick <code>Ctrl+C</code>;
                            Floaty puts your previous clipboard text back afterwards.</span>
                    </div>

                    <div class="field">
                        <label for="autostartMode">Start with Windows</label>
                        <select id="autostartMode" @bind="_config.AutostartMode">
                            <option value="@AutostartMode.Disabled">Don't start automatically</option>
                            <option value="@AutostartMode.Minimized">Start minimized (tray only)</option>
                            <option value="@AutostartMode.Visible">Start visible</option>
                        </select>
                        <span class="hint">@AutostartModeHint(_config.AutostartMode)</span>
                    </div>
                }
            }
            else if (_activeSection == SettingsSection.Appearance)
            {
                <div class="card-head">
                    <h2>Appearance</h2>
                    <p>Choose the ring image used by the floating overlay.</p>
                </div>

                <div class="field">
                    <label>Ring image</label>

                    <div class="ring-strip" role="list" aria-label="Ring image options">
                        @foreach (var option in _ringOptions)
                        {
                            <button type="button" role="listitem"
                                    class="ring-option @(IsSelectedRing(option.Value) ? "selected" : string.Empty)"
                                    title="@option.Label" @onclick="() => SelectRing(option.Value)">
                                <span class="ring-preview">
                                    @if (!string.IsNullOrWhiteSpace(option.PreviewSrc))
                                    {
                                        <img src="@option.PreviewSrc" alt="@option.Label" loading="lazy" />
                                    }
                                    else
                                    {
                                        <span class="ring-fallback">@option.Label[..1].ToUpperInvariant()</span>
                                    }
                                </span>
                                <span class="ring-name">@option.Label</span>
                                <span class="ring-kind">@(option.IsBuiltIn ? "Built-in" : "Custom")</span>
                            </button>
                        }
                    </div>

                    <span class="hint">
                        Built-ins come from app resources. Add your own images to <code>~/.floaty/ring</code> and click
                        Reload.
                    </span>
                </div>

                <div class="field">
                    <label for="ringSize">Ring size</label>
                    <div class="ring-size-row">
                        <input id="ringSize" type="range"
                               min="@SettingsService.RingMinSize" max="@SettingsService.RingMaxSize" step="1"
                               value="@((int)_config.RingSize)"
                               @oninput="OnRingSizeInput" />
                        <span class="ring-size-value">@((int)_config.RingSize) px</span>
                    </div>
                    <span class="hint">Drag to resize the overlay ring — it updates live. You can also hold
                        <code>Ctrl</code> and scroll over the ring.</span>
                </div>

                <div class="field">
                    <label for="chatPanelPlacement">Chat panel</label>
                    <select id="chatPanelPlacement" @bind="_config.ChatPanelPlacement">
                        <option value="@ChatPanelPlacement.Floating">Floating (next to the ring)</option>
                        <option value="@ChatPanelPlacement.Fixed">Fixed (own window)</option>
                    </select>
                    <span class="hint">@ChatPanelPlacementHint(_config.ChatPanelPlacement)</span>
                </div>

                <div class="field">
                    <label>Accent color</label>
                    <div class="accent-row" role="list" aria-label="Accent color options">
                        @foreach (var preset in AccentPresets)
                        {
                            <button type="button" role="listitem"
                                    class="accent-swatch @(IsSelectedAccent(preset.Value) ? "selected" : string.Empty)"
                                    style="background:@preset.Value" title="@preset.Label"
                                    @onclick="() => SelectAccent(preset.Value)"></button>
                        }
                        <input type="color" class="accent-custom" value="@_config.AccentColor"
                               @oninput="OnAccentColorInput" title="Custom color" />
                    </div>
                    <span class="hint">Used for buttons, chat bubbles and highlights. Previews live; committed on
                        Save.</span>
                </div>

                <div class="actions sub-actions">
                    <button class="reload" @onclick="ReloadRingImages">
                        <i class="ti ti-refresh" aria-hidden="true"></i>
                        <span>Reload</span>
                    </button>
                    <span class="hint">Loaded @_ringOptions.Count option(s), including @_customRingCount custom
                        image(s).</span>
                    </div>
                }
            else if (_activeSection == SettingsSection.Sounds)
            {
                <div class="card-head">
                    <h2>Sounds</h2>
                    <p>Floaty's own sound effects. Each one can be turned off or swapped for another sound.</p>
                </div>

                @foreach (var slot in SoundSlots)
                {
                    <div class="field">
                        <label>@slot.Label</label>
                        <label class="hint" style="display:flex;gap:8px;align-items:center;cursor:pointer">
                            <input type="checkbox" checked="@slot.GetEnabled(_config)"
                                   @onchange="e => SetSoundEnabled(slot, e.Value as bool? == true)" />
                            @slot.ToggleText
                        </label>

                        <div class="mcp-list">
                            @foreach (var option in _soundOptions)
                            {
                                <div class="mcp-row">
                                    <input type="radio" name="@slot.Key"
                                           checked="@IsSelectedSound(slot, option.Value)"
                                           @onchange="() => SelectSound(slot, option.Value)"
                                           title="Use this sound" />
                                    <div class="mcp-info">
                                        <span class="mcp-name">
                                            <i class="ti ti-music" aria-hidden="true"></i> @option.Label
                                        </span>
                                        <span class="mcp-meta">@(option.IsBuiltIn ? "Built-in" : "Custom")</span>
                                    </div>
                                    <button class="mcp-remove" @onclick="() => PreviewSound(option.Value)"
                                            title="Play this sound">
                                        <i class="ti ti-player-play" aria-hidden="true"></i>
                                        <span>Play</span>
                                    </button>
                                </div>
                            }
                        </div>

                        <span class="hint">@slot.Hint</span>
                    </div>
                }

                <div class="field">
                    <label for="soundVolume">Volume</label>
                    <div class="ring-size-row">
                        <input id="soundVolume" type="range" min="0" max="100" step="1"
                               value="@((int)Math.Round(_config.SoundVolume * 100))"
                               @oninput="OnSoundVolumeInput" />
                        <span class="ring-size-value">@((int)Math.Round(_config.SoundVolume * 100))%</span>
                    </div>
                    <span class="hint">Applies to every sound above. Press Play on any sound to hear the
                        current setting — previews use the live value, so you can hear it before saving.</span>
                </div>

                <div class="actions sub-actions">
                    <button class="reload" @onclick="ReloadSounds">
                        <i class="ti ti-refresh" aria-hidden="true"></i>
                        <span>Reload</span>
                    </button>
                    <button class="reload" @onclick="OpenSoundsFolder">
                        <i class="ti ti-folder" aria-hidden="true"></i>
                        <span>Open folder</span>
                    </button>
                    <span class="hint">Loaded @_soundOptions.Count sound(s), including @_customSoundCount
                        custom.</span>
                </div>
                <span class="hint">Built-ins are packaged with Floaty (public-domain sounds from
                    BigSoundBank). Drop your own <code>.wav</code> or <code>.mp3</code> files into
                    <code>~/.floaty/sounds</code> and click Reload. Selections apply on Save.</span>
            }
            else if (_activeSection == SettingsSection.ScreenHistory)
            {
                <div class="card-head">
                    <h2>Screen History</h2>
                    <p>Automatically remember what's on your screen when you switch windows or tabs.</p>
                </div>

                <div class="field">
                    <label for="screenHistoryMode">Capture mode</label>
                    <select id="screenHistoryMode" @bind="_config.ScreenHistoryMode">
                        <option value="@ScreenHistoryMode.Disabled">Disabled</option>
                        <option value="@ScreenHistoryMode.TextOnly">Text only</option>
                        <option value="@ScreenHistoryMode.TextAndScreenshot">Text + screenshot</option>
                    </select>
                    <span class="hint">@ScreenHistoryModeHint(_config.ScreenHistoryMode)</span>
                </div>

                <div class="field">
                    <label>Chat attachments</label>
                    <label class="hint" style="display:flex;gap:8px;align-items:center;cursor:pointer">
                        <input type="checkbox" @bind="_config.RememberTaggedCaptures" />
                        Remember windows attached with @@ in chat
                    </label>
                    <span class="hint">When you attach a window to a prompt by typing @@, its capture is also
                        saved to memory so you can recall it later.</span>
                </div>

                <div class="field">
                    <label>Dropped files</label>
                    <label class="hint" style="display:flex;gap:8px;align-items:center;cursor:pointer">
                        <input type="checkbox" @bind="_config.RememberDroppedFiles" />
                        Remember files dropped on Floaty
                    </label>
                    <span class="hint">Off by default: a file you drop on the ring or the chat panel is used
                        once as context for that message and then forgotten. Turn this on to also copy it into
                        <code>~/.floaty/drops</code> and embed its text so you can recall it later. Every
                        attachment chip has its own toggle that overrides this for a single file — the choice
                        takes effect when you send the message.</span>
                    <span class="hint">Hold <kbd>Alt</kbd> while dropping to skip the chat entirely: the files
                        go straight into memory and never touch the prompt. Works on the ring and the chat
                        panel, and ignores this setting.</span>
                </div>

                <div class="field">
                    <label>Privacy</label>
                    <span class="hint">Everything stays on this machine: capture files in
                        <code>~/.floaty/captures</code>, the searchable index in <code>~/.floaty/floaty.db</code>.
                        Capture text (and screenshots, in that mode) is sent to your configured OpenAI models to
                        be embedded/described. Ask Floaty things like “what was I reading about X earlier?” to
                        search it.</span>
                </div>

                <div class="field">
                    <label>Stored history</label>
                    <div class="actions sub-actions">
                        @if (!_confirmClearHistory)
                        {
                            <button class="reload" @onclick="() => _confirmClearHistory = true" disabled="@_clearingHistory">
                                <i class="ti ti-trash" aria-hidden="true"></i>
                                <span>Clear screen history</span>
                            </button>
                        }
                        else
                        {
                            <button class="reload" @onclick="ClearScreenHistory" disabled="@_clearingHistory">
                                <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                <span>@(_clearingHistory ? "Clearing…" : "Yes, delete it all")</span>
                            </button>
                            <button class="reload" @onclick="() => _confirmClearHistory = false" disabled="@_clearingHistory">
                                <span>Cancel</span>
                            </button>
                        }
                        <span class="hint">@(_autoCaptureCount is int n ? $"{n} snapshot(s) stored." : "Counting…")</span>
                    </div>
                    <span class="hint">Deletes all automatic snapshots and their files. Captures you took
                        yourself (📷 or <code>/capture</code>) and saved notes are kept.</span>
                </div>

                <div class="field">
                    <label>Search index</label>
                    <div class="actions sub-actions">
                        <button class="reload" @onclick="ReindexCaptures" disabled="@(_reindexing || _clearingHistory)">
                            <i class="ti ti-refresh" aria-hidden="true"></i>
                            <span>@(_reindexing ? "Re-indexing…" : "Re-index stored captures")</span>
                        </button>
                        @if (_reindexProgress is (int done, int total) && total > 0)
                        {
                            <span class="hint">@done / @total</span>
                        }
                        else if (_reindexResult is string msg)
                        {
                            <span class="hint">@msg</span>
                        }
                    </div>
                    <span class="hint">Older snapshots were indexed only by their first few thousand
                        characters, so anything further down couldn't be found. This re-reads each saved
                        capture in full and re-indexes it in pieces. It re-sends that text to your
                        embedding model, so it costs a little — run it once.</span>
                </div>
            }
            else if (_activeSection == SettingsSection.VoiceInput)
            {
                <div class="card-head">
                    <h2>Voice Input</h2>
                    <p>Dictate chat messages with a local, offline speech-to-text model.</p>
                </div>

                <div class="mcp-list">
                    <div class="mcp-row">
                        <input type="radio" name="sttModel" checked="@(_config.SttSelectedModelId is null)"
                               @onchange="() => SelectSttModel(null)" title="Voice input off" />
                        <div class="mcp-info">
                            <span class="mcp-name"><i class="ti ti-microphone-off" aria-hidden="true"></i> Off</span>
                            <span class="mcp-meta">No voice input; the mic button is hidden.</span>
                        </div>
                    </div>
                    @foreach (var model in SttModelCatalog.Models)
                    {
                        var downloaded = IsSttDownloaded(model);
                        <div class="mcp-row">
                            <input type="radio" name="sttModel" checked="@(_config.SttSelectedModelId == model.Id)"
                                   disabled="@(!downloaded)"
                                   @onchange="() => SelectSttModel(model.Id)" title="Use this model" />
                            <div class="mcp-info">
                                <span class="mcp-name"><i class="ti ti-microphone" aria-hidden="true"></i> @model.DisplayName</span>
                                <span class="mcp-meta">
                                    @if (model.IsAvailable)
                                    {
                                        @($"{model.SizeNote} · {model.LanguageNote}{(model.GpuRecommended ? " · GPU recommended" : "")}")
                                    }
                                    else
                                    {
                                        @("Coming soon")
                                    }
                                </span>
                            </div>
                            @if (!model.IsAvailable)
                            {
                                <!-- no actions for models we can't run yet -->
                            }
                            else if (_sttDownloading.Contains(model.Id))
                            {
                                <button class="mcp-remove" disabled>
                                    <i class="ti ti-download" aria-hidden="true"></i>
                                    <span>@($"{(int)(_sttProgress.GetValueOrDefault(model.Id) * 100)}%")</span>
                                </button>
                            }
                            else if (!downloaded)
                            {
                                <button class="mcp-remove" @onclick="() => DownloadSttModel(model)">
                                    <i class="ti ti-download" aria-hidden="true"></i>
                                    <span>Download</span>
                                </button>
                            }
                            else if (_confirmDeleteModelId == model.Id)
                            {
                                <button class="mcp-remove" @onclick="() => DeleteSttModel(model)">
                                    <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                    <span>Really delete?</span>
                                </button>
                                <button class="mcp-remove" @onclick="() => _confirmDeleteModelId = null">
                                    <span>Cancel</span>
                                </button>
                            }
                            else
                            {
                                <button class="mcp-remove" @onclick="() => _confirmDeleteModelId = model.Id">
                                    <i class="ti ti-trash" aria-hidden="true"></i>
                                    <span>Delete</span>
                                </button>
                            }
                        </div>
                    }
                </div>
                @if (_sttError is not null)
                {
                    <p class="hint">@_sttError</p>
                }
                <span class="hint">Models download to <code>~/.floaty/models</code> and run entirely on this
                    machine (GPU-accelerated where available), sharing a small speech engine (~26 MB)
                    fetched automatically with the first model. Downloads apply immediately; the selected
                    model and send mode apply on Save.</span>

                <div class="field">
                    <label for="voiceSendMode">Send mode</label>
                    <select id="voiceSendMode" @bind="_config.VoiceSendMode">
                        <option value="@VoiceSendMode.Manual">Manual — I press send myself</option>
                        <option value="@VoiceSendMode.AutoSendOnPause">Auto-send after a pause</option>
                    </select>
                    <span class="hint">@(_config.VoiceSendMode == VoiceSendMode.AutoSendOnPause
                        ? "After you stop speaking for the pause length below, the message sends automatically."
                        : "Dictated text lands in the chat box; press send when you're ready.")</span>
                </div>

                @if (_config.VoiceSendMode == VoiceSendMode.AutoSendOnPause)
                {
                    <div class="field">
                        <label for="voicePauseSeconds">Pause length (seconds)</label>
                        <input id="voicePauseSeconds" type="number" min="1" max="10" step="0.5"
                               @bind="_config.AutoSendPauseSeconds" />
                        <span class="hint">Silence this long after you finish speaking sends the message.</span>
                    </div>
                }
            }
            else if (_activeSection == SettingsSection.Mcp)
            {
                <div class="card-head">
                    <h2>MCP Servers</h2>
                    <p>Add Model Context Protocol servers. Each is callable in chat via <code>/name</code>.</p>
                </div>

                @if (_config.McpServers.Count == 0)
                {
                    <p class="hint">No servers configured yet.</p>
                }
                else
                {
                    <div class="mcp-list">
                        @foreach (var server in _config.McpServers)
                        {
                            <div class="mcp-row">
                                <input type="checkbox" @bind="server.Enabled" title="Enabled" />
                                <div class="mcp-info">
                                    <span class="mcp-name"><i class="ti ti-server-2" aria-hidden="true"></i> /@server.Name</span>
                                    <span class="mcp-meta">@server.Transport · @(server.Transport == "http" ? server.Url : server.Command)</span>
                                </div>
                                <button class="mcp-remove" @onclick="() => RemoveServer(server)">
                                    <i class="ti ti-trash" aria-hidden="true"></i>
                                    <span>Remove</span>
                                </button>
                            </div>
                        }
                    </div>
                }

                <div class="mcp-add">
                    <h3>Add server</h3>

                    <div class="field">
                        <label for="mcpName">Name</label>
                        <input id="mcpName" type="text" autocomplete="off" spellcheck="false" placeholder="github"
                               @bind="_newServer.Name" @bind:event="oninput" />
                        <span class="hint">Used as the <code>/name</code> slash command.</span>
                    </div>

                    <div class="field">
                        <label for="mcpTransport">Transport</label>
                        <select id="mcpTransport" @bind="_newServer.Transport">
                            <option value="stdio">stdio (local command)</option>
                            <option value="http">http (remote URL)</option>
                        </select>
                    </div>

                    @if (_newServer.Transport == "http")
                    {
                        <div class="field">
                            <label for="mcpUrl">URL</label>
                            <input id="mcpUrl" type="text" autocomplete="off" spellcheck="false"
                                   placeholder="https://example.com/mcp" @bind="_newServer.Url" @bind:event="oninput" />
                        </div>
                        <div class="field">
                            <label for="mcpHeaders">Headers</label>
                            <textarea id="mcpHeaders" rows="3" @bind="_newServerHeaders" @bind:event="oninput"></textarea>
                            <span class="hint">One <code>KEY=VALUE</code> per line (e.g. <code>Authorization=Bearer …</code>).</span>
                        </div>
                    }
                    else
                    {
                        <div class="field">
                            <label for="mcpCommand">Command</label>
                            <input id="mcpCommand" type="text" autocomplete="off" spellcheck="false" placeholder="npx"
                                   @bind="_newServer.Command" @bind:event="oninput" />
                        </div>
                        <div class="field">
                            <label for="mcpArgs">Arguments</label>
                            <textarea id="mcpArgs" rows="3" @bind="_newServerArgs" @bind:event="oninput"></textarea>
                            <span class="hint">One argument per line.</span>
                        </div>
                        <div class="field">
                            <label for="mcpEnv">Environment</label>
                            <textarea id="mcpEnv" rows="2" @bind="_newServerEnv" @bind:event="oninput"></textarea>
                            <span class="hint">One <code>KEY=VALUE</code> per line.</span>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_mcpError))
                    {
                        <p class="mcp-error">@_mcpError</p>
                    }

                    <button class="reload" @onclick="AddServer">
                        <i class="ti ti-plus" aria-hidden="true"></i>
                        <span>Add server</span>
                    </button>
                </div>
            }
            else if (_activeSection == SettingsSection.Exec)
            {
                <div class="card-head">
                    <h2>Shell</h2>
                    <p>Let Floaty run shell commands to create and edit files, launch apps, and automate your
                        computer. Off by default.</p>
                </div>

                <div class="field">
                    <label>Command execution</label>
                    <label class="hint" style="display:flex;gap:8px;align-items:center;cursor:pointer">
                        <input type="checkbox" @bind="_config.ExecEnabled" />
                        Enable the shell command tool
                    </label>
                    <span class="hint">When enabled, Floaty can run shell commands from chat based on the
                        approval mode below.</span>
                </div>

                @if (_config.ExecEnabled)
                {
                    <div class="field">
                        <label for="execApprovalMode">Approval mode</label>
                        <select id="execApprovalMode" @bind="_config.ExecApprovalMode">
                            <option value="@ExecApprovalMode.AlwaysRequire">Always require human in the loop</option>
                            <option value="@ExecApprovalMode.NeverRequire">Never require human in the loop</option>
                        </select>
                        <span class="hint">@(_config.ExecApprovalMode == ExecApprovalMode.AlwaysRequire
                            ? "Each command opens a Run / Cancel approval prompt in the overlay."
                            : "Commands run immediately without an approval prompt. Use with caution.")</span>
                    </div>

                    <div class="field">
                        <label for="execShell">Default shell</label>
                        <select id="execShell" @bind="_config.ExecShell">
                            <option value="@ExecShellKind.PowerShell">Windows PowerShell (powershell.exe)</option>
                            <option value="@ExecShellKind.Pwsh">PowerShell Core (pwsh)</option>
                            <option value="@ExecShellKind.Cmd">Command Prompt (cmd.exe)</option>
                            <option value="@ExecShellKind.Bash">bash</option>
                            <option value="@ExecShellKind.Zsh">zsh</option>
                            <option value="@ExecShellKind.Sh">sh</option>
                            <option value="@ExecShellKind.Custom">Custom…</option>
                        </select>
                        <span class="hint">The shell commands are run through.</span>
                    </div>

                    @if (_config.ExecShell == ExecShellKind.Custom)
                    {
                        <div class="field">
                            <label for="execCustomPath">Custom shell executable</label>
                            <input id="execCustomPath" type="text" autocomplete="off" spellcheck="false"
                                   placeholder="/usr/bin/fish" @bind="_config.ExecCustomShellPath"
                                   @bind:event="oninput" />
                            <span class="hint">Full path to the shell executable to launch.</span>
                        </div>

                        <div class="field">
                            <label for="execCustomArgs">Custom arguments</label>
                            <input id="execCustomArgs" type="text" autocomplete="off" spellcheck="false"
                                   placeholder="-c {command}" @bind="_config.ExecCustomShellArgs"
                                   @bind:event="oninput" />
                            <span class="hint">Arguments passed before the command. The <code>{command}</code>
                                token is replaced by the command text; if omitted, the command is appended as a
                                final argument.</span>
                        </div>
                    }
                }
            }
            else if (_activeSection == SettingsSection.Skills)
            {
                <div class="card-head">
                    <h2>Skills</h2>
                    <p>Agent skills (SKILL.md) from <code>~/.floaty/skills</code>, <code>~/.claude/skills</code> and
                       <code>~/.agents/skills</code>. Each enabled skill is callable in chat via <code>/name</code>.</p>
                </div>

                <div class="actions sub-actions">
                    <button class="reload" @onclick="ReloadSkills">
                        <i class="ti ti-refresh" aria-hidden="true"></i>
                        <span>Reload</span>
                    </button>
                    <button class="reload" @onclick="OpenSkillsFolder">
                        <i class="ti ti-folder" aria-hidden="true"></i>
                        <span>Open folder</span>
                    </button>
                    <span class="hint">Found @_skills.Count skill(s).</span>
                </div>

                @if (_skills.Count == 0)
                {
                    <p class="hint">No skills found. Drop a folder containing a <code>SKILL.md</code> into
                        <code>~/.floaty/skills</code> and click Reload.</p>
                }
                else
                {
                    <div class="mcp-list">
                        @foreach (var skill in _skills)
                        {
                            <div class="mcp-row">
                                <input type="checkbox" checked="@IsSkillEnabled(skill.Name)"
                                       @onchange="e => SetSkillEnabled(skill.Name, (bool)(e.Value ?? false))" title="Enabled" />
                                <div class="mcp-info">
                                    <span class="mcp-name"><i class="ti ti-bolt" aria-hidden="true"></i> /@skill.Name</span>
                                    <span class="mcp-meta">@(string.IsNullOrWhiteSpace(skill.Description) ? skill.SourcePath : skill.Description)</span>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
            else if (_activeSection == SettingsSection.Updates)
            {
                <div class="card-head">
                    <h2>Updates</h2>
                    <p>Keep Floaty up to date. New versions are published on GitHub.</p>
                </div>

                <div class="field">
                    <label>Current version</label>
                    <span class="hint">You are running <code>@UpdateService.CurrentVersion</code>.</span>
                </div>

                @if (!UpdateService.IsSupported)
                {
                    <p class="hint">
                        Automatic updates are only available in installed builds. Download the latest
                        release from the
                        <a href="#" @onclick="OpenReleasesPage" @onclick:preventDefault="true">releases page</a>.
                    </p>
                }
                else if (_updatePending)
                {
                    <p class="hint">An update to <code>@_latestVersion</code> has been downloaded and is
                        ready to install.</p>

                    <div class="actions">
                        <button class="save" @onclick="RestartAndUpdate">
                            <i class="ti ti-refresh" aria-hidden="true"></i>
                            <span>Restart &amp; update</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="actions sub-actions">
                        <button class="reload" @onclick="CheckForUpdates" disabled="@(_checking || _downloading)">
                            <i class="ti ti-cloud-download" aria-hidden="true"></i>
                            <span>@(_checking ? "Checking…" : "Check for updates")</span>
                        </button>
                        @if (!string.IsNullOrEmpty(_updateStatus))
                        {
                            <span class="hint">@_updateStatus</span>
                        }
                    </div>

                    @if (_updateAvailable)
                    {
                        <p class="hint">Version <code>@_latestVersion</code> is available.</p>

                        <div class="actions">
                            <button class="save" @onclick="DownloadUpdate" disabled="@_downloading">
                                <i class="ti ti-download" aria-hidden="true"></i>
                                <span>@(_downloading ? $"Downloading… {_downloadProgress}%" : "Download & install")</span>
                            </button>
                        </div>
                    }
                }

                @if (!string.IsNullOrWhiteSpace(_notesHtml))
                {
                    <div class="whats-new">
                        <h3>What's new@(string.IsNullOrEmpty(_latestVersion) ? string.Empty : $" in {_latestVersion}")</h3>
                        <div class="notes">@((MarkupString)_notesHtml)</div>
                    </div>
                }
            }
            else if (_activeSection == SettingsSection.ModelProvider)
            {
                <div class="card-head">
                    <h2>Model Provider</h2>
                    <p>Configure one or more providers, then pick which of them does what. Chat can
                        run on a good cloud model while embeddings and screenshot captioning — which
                        run constantly for screen history — stay on this machine.</p>
                </div>

                @if (_config.Providers.Count == 0)
                {
                    <p class="hint">No providers yet. Add one below to start chatting.</p>
                }
                else
                {
                    <div class="subtabs" role="tablist" aria-label="Configured providers">
                        @foreach (var provider in _config.Providers)
                        {
                            // ActiveProvider, not _activeProviderId: after a removal the id can point
                            // at nothing, and the panel falls back to the first provider — the tab
                            // strip has to follow it rather than highlight nothing.
                            var id = provider.Id;
                            var isActive = id == ActiveProvider?.Id;
                            <button type="button" role="tab" class="subtab @(isActive ? "active" : "")"
                                    aria-selected="@isActive"
                                    @onclick="() => SelectProvider(id)">
                                <span>@ProviderLabel(provider)</span>
                                @if (RoleCountFor(id) > 0)
                                {
                                    <span class="subtab-badge" title="Roles served by this provider">@RoleCountFor(id)</span>
                                }
                            </button>
                        }
                    </div>
                }

                <div class="field">
                    <label for="addProvider">Add a provider</label>
                    <div class="row-inline">
                        <select id="addProvider" @bind="_presetToAdd">
                            @foreach (var option in AvailablePresets())
                            {
                                <option value="@option.Id">@option.DisplayName</option>
                            }
                        </select>
                        <button class="reload" @onclick="AddProvider" disabled="@(AvailablePresets().Count == 0)">
                            <i class="ti ti-plus" aria-hidden="true"></i>
                            <span>Add</span>
                        </button>
                    </div>
                    @if (ProviderPresets.Find(_presetToAdd) is { } previewPreset)
                    {
                        <span class="hint">@previewPreset.Blurb</span>
                    }
                </div>

                @if (ActiveProvider is { } active)
                {
                    var preset = ProviderPresets.Find(active.PresetId);

                    <div class="provider-panel">
                        <div class="card-head">
                            <h3>@ProviderLabel(active)</h3>
                            @if (preset is not null)
                            {
                                <p>@preset.Blurb</p>
                            }
                        </div>

                        @if (preset?.AllowMultiple == true)
                        {
                            <div class="field">
                                <label for="providerName">Name</label>
                                <input id="providerName" type="text" autocomplete="off" spellcheck="false"
                                       @bind="active.DisplayName" @bind:event="oninput" />
                                <span class="hint">Shown on this tab and in the role pickers below.</span>
                            </div>
                        }

                        @if (active.Kind == ProviderKind.LocalOnnx)
                        {
                            @if (!LocalEmbeddings.IsSupported)
                            {
                                <p class="hint">On-device models are not available on this platform.</p>
                            }
                            else
                            {
                                <div class="mcp-list">
                                    @foreach (var model in LocalModelCatalog.Models)
                                    {
                                        var downloaded = ModelDownloads.IsDownloaded(model);
                                        <div class="mcp-row">
                                            <input type="radio" name="localEmbeddingModel"
                                                   checked="@(active.EmbeddingModel == model.Id)"
                                                   disabled="@(!downloaded)"
                                                   @onchange="() => SelectLocalEmbeddingModel(active, model.Id)"
                                                   title="Use this model" />
                                            <div class="mcp-info">
                                                <span class="mcp-name"><i class="ti ti-cpu" aria-hidden="true"></i> @model.DisplayName</span>
                                                <span class="mcp-meta">@($"{model.SizeNote} · {model.LanguageNote} · {model.Dimensions} dims")</span>
                                            </div>
                                            @if (_embeddingDownloading.Contains(model.Id))
                                            {
                                                <button class="mcp-remove" disabled>
                                                    <i class="ti ti-download" aria-hidden="true"></i>
                                                    <span>@($"{(int)(_embeddingProgress.GetValueOrDefault(model.Id) * 100)}%")</span>
                                                </button>
                                            }
                                            else if (!downloaded)
                                            {
                                                <button class="mcp-remove" @onclick="() => DownloadEmbeddingModel(model)">
                                                    <i class="ti ti-download" aria-hidden="true"></i>
                                                    <span>Download</span>
                                                </button>
                                            }
                                            else if (_confirmDeleteEmbeddingId == model.Id)
                                            {
                                                <button class="mcp-remove" @onclick="() => DeleteEmbeddingModel(active, model)">
                                                    <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                                    <span>Really delete?</span>
                                                </button>
                                                <button class="mcp-remove" @onclick="() => _confirmDeleteEmbeddingId = null">
                                                    <span>Cancel</span>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="mcp-remove" @onclick="() => _confirmDeleteEmbeddingId = model.Id">
                                                    <i class="ti ti-trash" aria-hidden="true"></i>
                                                    <span>Delete</span>
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                                @if (_embeddingError is not null)
                                {
                                    <p class="hint">@_embeddingError</p>
                                }
                                <span class="hint">Models download to <code>~/.floaty/models/embed</code> and run
                                    in-process. Nothing is sent anywhere, so screen history keeps indexing even with
                                    no API key configured. Downloads apply immediately; the selection applies on Save.</span>
                            }
                        }
                        else
                        {
                            @if (preset?.NeedsKey != false)
                            {
                                <div class="field">
                                    <label for="providerKey">API key</label>
                                    <input id="providerKey" type="password" autocomplete="off" spellcheck="false"
                                           placeholder="@(active.Kind == ProviderKind.Anthropic ? "sk-ant-..." : "sk-...")"
                                           @bind="active.ApiKey" @bind:event="oninput" />
                                    <span class="hint">
                                        Stored locally in <code>~/.floaty/config.json</code>. Never leaves your machine
                                        except to call @ProviderLabel(active).
                                        @if (preset?.KeyUrl is { } keyUrl)
                                        {
                                            <a href="@keyUrl" target="_blank" rel="noreferrer">Get a key</a>
                                        }
                                    </span>
                                </div>
                            }

                            <div class="field">
                                <label for="providerBaseUrl">Base URL</label>
                                <input id="providerBaseUrl" type="text" autocomplete="off" spellcheck="false"
                                       placeholder="@(string.IsNullOrEmpty(preset?.BaseUrl) ? "https://api.openai.com/v1" : preset!.BaseUrl)"
                                       @bind="active.BaseUrl" @bind:event="oninput" />
                                <span class="hint">Leave blank to use the default endpoint.</span>
                            </div>

                            @if (IsOllama(active))
                            {
                                <div class="actions sub-actions">
                                    <button class="reload" @onclick="() => RefreshOllamaModels(active)" disabled="@_ollamaLoading">
                                        <i class="ti ti-refresh" aria-hidden="true"></i>
                                        <span>@(_ollamaLoading ? "Checking…" : "Refresh models")</span>
                                    </button>
                                    @if (!_ollamaLoading && _ollamaModels.Count == 0)
                                    {
                                        <span class="hint">Ollama is not responding. Start it, then refresh.</span>
                                    }
                                </div>
                            }

                            <div class="field">
                                <label for="providerChatModel">Chat model</label>
                                @if (ShowOllamaPicker(active))
                                {
                                    <select id="providerChatModel" @bind="active.ChatModel">
                                        <option value="">— none —</option>
                                        @foreach (var name in _ollamaModels)
                                        {
                                            <option value="@name">@name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input id="providerChatModel" type="text" autocomplete="off" spellcheck="false"
                                           placeholder="@preset?.ChatModel" @bind="active.ChatModel" @bind:event="oninput" />
                                }
                                <span class="hint">@(active.Kind == ProviderKind.AzureOpenAI
                                    ? "Your deployment name, not the underlying model name."
                                    : "Leave blank if this provider should not answer chats.")</span>
                            </div>

                            <div class="field">
                                <label for="providerEmbeddingModel">Embedding model</label>
                                @if (ShowOllamaPicker(active))
                                {
                                    <select id="providerEmbeddingModel" @bind="active.EmbeddingModel">
                                        <option value="">— none —</option>
                                        @foreach (var name in _ollamaModels)
                                        {
                                            <option value="@name">@name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input id="providerEmbeddingModel" type="text" autocomplete="off" spellcheck="false"
                                           placeholder="@preset?.EmbeddingModel" @bind="active.EmbeddingModel"
                                           @bind:event="oninput" disabled="@(active.Kind == ProviderKind.Anthropic)" />
                                }
                                <span class="hint">@(active.Kind == ProviderKind.Anthropic
                                    ? "Anthropic has no embedding models — use Local or another provider for memory."
                                    : "Vectorizes captures for memory search.")</span>
                            </div>

                            <div class="field">
                                <label for="providerVisionModel">Vision model</label>
                                @if (ShowOllamaPicker(active))
                                {
                                    <select id="providerVisionModel" @bind="active.VisionModel">
                                        <option value="">— none —</option>
                                        @foreach (var name in _ollamaModels)
                                        {
                                            <option value="@name">@name</option>
                                        }
                                    </select>
                                }
                                else
                                {
                                    <input id="providerVisionModel" type="text" autocomplete="off" spellcheck="false"
                                           placeholder="@preset?.VisionModel" @bind="active.VisionModel" @bind:event="oninput" />
                                }
                                <span class="hint">Describes captured screenshots so they are searchable by content.</span>
                            </div>

                            @if (active.Kind == ProviderKind.OpenAI)
                            {
                                <div class="field">
                                    <label>API style</label>
                                    <label class="hint" style="display:flex;gap:8px;align-items:center;cursor:pointer">
                                        <input type="checkbox" @bind="active.UseResponsesApi" />
                                        Use the Responses API
                                    </label>
                                    <span class="hint">Off falls back to chat completions. Only turn this off if a
                                        model you want is not available on Responses.</span>
                                </div>
                            }
                        }

                        <div class="actions sub-actions">
                            <button class="reload" @onclick="() => TestProvider(active)" disabled="@_testing">
                                <i class="ti ti-plug-connected" aria-hidden="true"></i>
                                <span>@(_testing ? "Testing…" : "Test")</span>
                            </button>
                            @if (_testResults.TryGetValue(active.Id, out var testResult))
                            {
                                <span class="hint">@testResult</span>
                            }
                            @if (_confirmRemoveProviderId == active.Id)
                            {
                                <button class="mcp-remove" @onclick="() => RemoveProvider(active)">
                                    <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                                    <span>Really remove?</span>
                                </button>
                                <button class="mcp-remove" @onclick="() => _confirmRemoveProviderId = null">
                                    <span>Cancel</span>
                                </button>
                            }
                            else
                            {
                                <button class="mcp-remove" @onclick="() => _confirmRemoveProviderId = active.Id">
                                    <i class="ti ti-trash" aria-hidden="true"></i>
                                    <span>Remove</span>
                                </button>
                            }
                        </div>
                    </div>
                }

                <div class="card-head roles-head">
                    <h3>Roles</h3>
                    <p>Which provider does what. Each list only offers providers that have a model
                        configured for that job.</p>
                </div>

                <div class="field">
                    <label for="roleChat">Chat</label>
                    <select id="roleChat" value="@RoleKey(_config.ChatRole)"
                            @onchange="e => AssignRole(_config.ChatRole, e.Value?.ToString())">
                        <option value="">— not configured —</option>
                        @foreach (var option in RoleOptions(ModelRole.Chat))
                        {
                            <option value="@option.Key">@option.Label</option>
                        }
                    </select>
                    <span class="hint">Answers your messages and calls Floaty's tools.</span>
                </div>

                <div class="field">
                    <label for="roleEmbedding">Embeddings</label>
                    <select id="roleEmbedding" value="@RoleKey(_config.EmbeddingRole)"
                            @onchange="e => AssignRole(_config.EmbeddingRole, e.Value?.ToString())">
                        <option value="">— memory disabled —</option>
                        @foreach (var option in RoleOptions(ModelRole.Embedding))
                        {
                            <option value="@option.Key">@option.Label</option>
                        }
                    </select>
                    <span class="hint">Vectorizes every capture, so this one runs constantly. A local
                        model keeps screen history free and offline.</span>
                    @if (EmbeddingRoleChanged)
                    {
                        <span class="hint warn">
                            <i class="ti ti-alert-triangle" aria-hidden="true"></i>
                            This changes the vector space. Existing captures stay unsearchable until you
                            re-index them under Screen History.
                        </span>
                    }
                </div>

                <div class="field">
                    <label for="roleVision">Screenshot captioning</label>
                    <select id="roleVision" value="@RoleKey(_config.VisionRole)"
                            @onchange="e => AssignRole(_config.VisionRole, e.Value?.ToString())">
                        <option value="">— off —</option>
                        @foreach (var option in RoleOptions(ModelRole.Vision))
                        {
                            <option value="@option.Key">@option.Label</option>
                        }
                    </select>
                    <span class="hint">Describes screenshots so they are searchable by what was on
                        screen. Runs on every screen-history capture in "Text + screenshot" mode.</span>
                </div>
            }

            <div class="actions">
                <button class="save" @onclick="Save">
                    <i class="ti ti-device-floppy" aria-hidden="true"></i>
                    <span>Save</span>
                </button>
                @if (_saved)
                {
                    <span class="saved">Saved</span>
                }
            </div>
        </div>
    </section>
</div>

@code {
    private const string DefaultSystemPrompt =
        "You are Floaty, a desktop assistant that lives in a floating overlay. The user can capture " +
        "what's on their screen, and Floaty may also snapshot windows automatically as the user switches " +
        "between them (screen history); both are stored in local memory. When the user asks about " +
        "something they previously saw, viewed, read, or captured — or about their earlier activity — " +
        "call the search_captures tool to retrieve it before answering, and ground your answer in what " +
        "it returns. Be concise.";

    private enum SettingsSection
    {
        Behavior,
        Appearance,
        Sounds,
        ModelProvider,
        ScreenHistory,
        VoiceInput,
        Mcp,
        Exec,
        Skills,
        Updates,
    }

    private sealed record RingImageOption(string Value, string Label, bool IsBuiltIn, string? PreviewSrc = null);

    private sealed record SoundOption(string Value, string Label, bool IsBuiltIn);

    /// <summary>
    /// One occasion Floaty makes a noise, paired with the config it reads and writes. Both slots draw
    /// from the same pool of sounds, so the section is one loop over these rather than two copies of
    /// the same markup.
    /// </summary>
    private sealed record SoundSlot(
        string Key,
        string Label,
        string ToggleText,
        string Hint,
        string DefaultSound,
        Func<FloatyConfig, bool> GetEnabled,
        Action<FloatyConfig, bool> SetEnabled,
        Func<FloatyConfig, string> GetSelection,
        Action<FloatyConfig, string> SetSelection);

    private static readonly SoundSlot[] SoundSlots =
    [
        new("captureSound",
            "Screen capture",
            "Play a sound when a window is captured",
            "Fires for /capture and for windows you attach with @. Automatic screen history stays " +
            "silent — it captures constantly. The ring's shutter animation plays either way.",
            SettingsService.DefaultCaptureSound,
            c => c.CaptureSoundEnabled,
            (c, v) => c.CaptureSoundEnabled = v,
            c => c.CaptureSoundFileName,
            (c, v) => c.CaptureSoundFileName = v),
        new("assistantDoneSound",
            "Assistant reply finished",
            "Play a sound when a reply finishes",
            "Plays once the assistant has stopped streaming, so you can look away while it works.",
            SettingsService.DefaultAssistantDoneSound,
            c => c.AssistantDoneSoundEnabled,
            (c, v) => c.AssistantDoneSoundEnabled = v,
            c => c.AssistantDoneSoundFileName,
            (c, v) => c.AssistantDoneSoundFileName = v),
    ];

    private static readonly (string Label, string Value)[] AccentPresets =
    [
        ("Blue", "#2b7fff"),
        ("Indigo", "#6366f1"),
        ("Violet", "#8b5cf6"),
        ("Pink", "#ec4899"),
        ("Red", "#ef4444"),
        ("Orange", "#f97316"),
        ("Green", "#22c55e"),
        ("Teal", "#14b8a6"),
    ];

    private FloatyConfig _config = new();
    private string _systemPrompt = string.Empty;
    private List<RingImageOption> _ringOptions = new();
    private int _customRingCount;
    private List<SoundOption> _soundOptions = new();
    private int _customSoundCount;
    private bool _saved;
    private SettingsSection _activeSection = SettingsSection.Behavior;

    // Add-MCP-server form state. Args/Env/Headers are edited as text and parsed on Add.
    private McpServerConfig _newServer = new();
    private string _newServerArgs = string.Empty;
    private string _newServerEnv = string.Empty;
    private string _newServerHeaders = string.Empty;
    private string? _mcpError;

    // Discovered agent skills (metadata); enable state is tracked via _config.DisabledSkills.
    private List<FloatySkill> _skills = new();

    // Screen history section state. The count loads lazily when the section is opened.
    private int? _autoCaptureCount;
    private bool _confirmClearHistory;
    private bool _clearingHistory;
    private bool _reindexing;
    private (int Done, int Total)? _reindexProgress;
    private string? _reindexResult;

    // Model Provider section state. Provider edits live on the _config clone and commit on Save;
    // local-model downloads (like the voice ones) hit disk immediately.
    private string _activeProviderId = string.Empty;
    private string _presetToAdd = ProviderPresets.OpenAiId;
    private string? _confirmRemoveProviderId;
    private readonly Dictionary<string, string> _testResults = new();
    private bool _testing;
    private readonly HashSet<string> _embeddingDownloading = new();
    private readonly Dictionary<string, double> _embeddingProgress = new();
    private string? _embeddingError;
    private string? _confirmDeleteEmbeddingId;
    private List<string> _ollamaModels = new();
    private bool _ollamaLoading;

    // The embedding role as it was when the page opened, so the "you must re-index" warning only
    // appears when this visit actually changes it.
    private string _originalEmbeddingRole = string.Empty;

    // Voice input section state. Downloads mutate disk immediately; selection/mode commit on Save.
    private readonly HashSet<string> _sttDownloading = new();
    private readonly Dictionary<string, double> _sttProgress = new();
    private string? _sttError;
    private string? _confirmDeleteModelId;

    // Update section state.
    private bool _checking;
    private bool _downloading;
    private bool _updateAvailable;
    private bool _updatePending;
    private int _downloadProgress;
    private string? _latestVersion;
    private string? _updateStatus;
    private string? _notesHtml;

    protected override async Task OnInitializedAsync()
    {
        // Work on a copy so edits aren't committed until the user clicks Save.
        var current = ConfigService.Current;
        _config = new FloatyConfig
        {
            Providers = current.Providers.Select(CloneProvider).ToList(),
            ChatRole = CloneRole(current.ChatRole),
            EmbeddingRole = CloneRole(current.EmbeddingRole),
            VisionRole = CloneRole(current.VisionRole),
            RingImageFileName = current.RingImageFileName,
            RingSize = current.RingSize,
            AccentColor = current.AccentColor,
            CaptureSoundEnabled = current.CaptureSoundEnabled,
            CaptureSoundFileName = current.CaptureSoundFileName,
            AssistantDoneSoundEnabled = current.AssistantDoneSoundEnabled,
            AssistantDoneSoundFileName = current.AssistantDoneSoundFileName,
            SoundVolume = current.SoundVolume,
            ScreenHistoryMode = current.ScreenHistoryMode,
            AutostartMode = current.AutostartMode,
            // Set from the ring's context menu, not this page — but the clone is saved wholesale, so
            // anything left out here is silently reset to its default on Save.
            AlwaysOnTop = current.AlwaysOnTop,
            ChatPanelPlacement = current.ChatPanelPlacement,
            ChatWindowX = current.ChatWindowX,
            ChatWindowY = current.ChatWindowY,
            ChatWindowWidth = current.ChatWindowWidth,
            ChatWindowHeight = current.ChatWindowHeight,
            RememberTaggedCaptures = current.RememberTaggedCaptures,
            RememberDroppedFiles = current.RememberDroppedFiles,
            AttachSelectionOnSummon = current.AttachSelectionOnSummon,
            McpServers = current.McpServers.Select(CloneServer).ToList(),
            DisabledSkills = new List<string>(current.DisabledSkills),
            SttSelectedModelId = current.SttSelectedModelId,
            VoiceSendMode = current.VoiceSendMode,
            AutoSendPauseSeconds = current.AutoSendPauseSeconds,
            ExecEnabled = current.ExecEnabled,
            ExecApprovalMode = current.ExecApprovalMode,
            ExecShell = current.ExecShell,
            ExecCustomShellPath = current.ExecCustomShellPath,
            ExecCustomShellArgs = current.ExecCustomShellArgs,
        };

        _activeProviderId = _config.Providers.FirstOrDefault()?.Id ?? string.Empty;
        _originalEmbeddingRole = RoleKey(_config.EmbeddingRole);
        _presetToAdd = AvailablePresets().FirstOrDefault()?.Id ?? string.Empty;

        _systemPrompt = ConfigService.GetSystemPrompt(DefaultSystemPrompt);
        _skills = SkillService.Skills.ToList();

        // A background startup check may have already downloaded an update; surface its notes.
        _updatePending = UpdateService.IsUpdatePending;
        if (_updatePending)
        {
            _latestVersion = UpdateService.PendingVersion;
            _notesHtml = UpdateService.PendingNotesHtml;
        }

        await ReloadRingImages();
        ReloadSounds();
    }

    private async Task CheckForUpdates()
    {
        _checking = true;
        _updateStatus = null;
        _updateAvailable = false;
        _notesHtml = null;
        StateHasChanged();

        var result = await UpdateService.CheckAsync();

        _checking = false;
        if (result.Error is not null)
        {
            _updateStatus = result.Error;
        }
        else if (result.UpdateAvailable)
        {
            _updateAvailable = true;
            _latestVersion = result.TargetVersion;
            _notesHtml = result.NotesHtml;
        }
        else
        {
            _updateStatus = "You're up to date.";
        }

        StateHasChanged();
    }

    private async Task DownloadUpdate()
    {
        _downloading = true;
        _downloadProgress = 0;
        StateHasChanged();

        var progress = new Progress<int>(p =>
        {
            _downloadProgress = p;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await UpdateService.DownloadAsync(progress);
            _updatePending = UpdateService.IsUpdatePending;
        }
        catch (Exception ex)
        {
            _updateStatus = ex.Message;
        }

        _downloading = false;
        _updateAvailable = false;
        StateHasChanged();
    }

