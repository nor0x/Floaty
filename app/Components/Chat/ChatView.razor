@using System.Collections.Specialized
@using Floaty.Services
@implements IAsyncDisposable
@inject IJSRuntime JS

@* Root of the chat message list. The panel around it is still native MAUI; this owns only the
   scrollable list of bubbles. Accent shades ride in as CSS custom properties on this element, which
   is how a settings colour preview repaints user bubbles without any interop. *@
<div class="chat-root" style="@Bridge.AccentCss">
    <div class="scroller" @ref="_scroller">
        <div class="content" @ref="_content">
            @foreach (var message in Bridge.Messages)
            {
                @* Keyed on the view-model reference so a parent re-render (a message was added) never
                   rebuilds the existing bubbles - that would drop their subscriptions and, more
                   visibly, discard any text the user had selected. *@
                <MessageBubble @key="message" Message="message" />
            }
        </div>
    </div>
</div>

@code {
    private ElementReference _scroller;
    private ElementReference _content;
    private IJSObjectReference? _module;
    private DotNetObjectReference<ChatView>? _self;

    [Parameter, EditorRequired]
    public ChatSurfaceBridge Bridge { get; set; } = default!;

    protected override void OnInitialized()
    {
        // Only structural changes are handled here. Text edits during streaming are handled by the
        // individual MessageBubble, so a 30 fps stream never re-diffs the whole list.
        Bridge.Messages.CollectionChanged += OnMessagesChanged;
        Bridge.AccentChanged += OnAccentChanged;
        Bridge.ScrollRequested += OnScrollRequested;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./chat.js");
        _self = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("init", _self, _scroller, _content);

        Bridge.SignalReady();
    }

    private void OnMessagesChanged(object? sender, NotifyCollectionChangedEventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnAccentChanged(object? sender, EventArgs e) =>
        _ = InvokeAsync(StateHasChanged);

    private void OnScrollRequested(object? sender, bool smooth) =>
        _ = InvokeAsync(async () =>
        {
            if (_module is not null)
                await _module.InvokeVoidAsync("scrollToBottom", smooth);
        });

    /// <summary>The rendered content resized; the panel turns this into the webview's height.</summary>
    [JSInvokable]
    public void OnContentHeight(double cssPixels, double devicePixelRatio) =>
        Bridge.ReportContentHeight(cssPixels, devicePixelRatio);

    /// <summary>A link in a message was clicked; the panel opens it outside the webview.</summary>
    [JSInvokable]
    public void OnLinkClicked(string href) => Bridge.RequestOpenLink(href);

    public async ValueTask DisposeAsync()
    {
        Bridge.Messages.CollectionChanged -= OnMessagesChanged;
        Bridge.AccentChanged -= OnAccentChanged;
        Bridge.ScrollRequested -= OnScrollRequested;

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The webview is already gone (panel torn down); nothing left to clean up.
            }
        }

        _self?.Dispose();
    }
}
