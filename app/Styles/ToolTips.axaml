<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Fluent's tooltip sizes its popup from a measure that comes up a hair short of what the text
         actually inks, so the trailing glyph gets clipped by the content presenter - a ring image
         tooltip read "daisy.pn". Padding wide enough to absorb the discrepancy is the cheapest fix;
         MaxWidth keeps a long custom ring filename from stretching into a single ribbon.

         Included from App.axaml rather than SettingsTheme.axaml: the overlay and the chat panel have
         tooltips too, and SettingsTheme is scoped to the settings window. -->
    <Style Selector="ToolTip">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="MaxWidth" Value="480" />
    </Style>

</Styles>
