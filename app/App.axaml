<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Floaty.App"
             RequestedThemeVariant="Default">

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>

    <Application.Resources>
        <!-- Accent colors, replaced at runtime from the configured accent (see App.ApplyAccentColor).
             They live on the Application rather than a window so the overlay, the fixed chat window
             and Settings all resolve the same DynamicResource. -->
        <Color x:Key="AccentColor">#2b7fff</Color>
        <Color x:Key="AccentIconOnDarkColor">#95bfff</Color>

        <!-- The two Tabler icon fonts, as separate families. Keep them separate, and keep their names
             distinct from each other - Avalonia's font matching is substring-based at both levels and
             will silently resolve the wrong file otherwise:

               * A source ending in .ttf is a *pattern*, not a path: FontFamilyLoader filters the
                 folder's assets with IndexOf(pattern) >= 0, so a source of "tabler-icons.ttf" also
                 picks up any sibling whose name contains "tabler-icons".
               * Family matching is FontManager's glyphTypeface.FamilyName.Contains(familyName), so a
                 font named "tabler-icons-filled" would still satisfy a request for "tabler-icons".

             Both fonts shipped reporting the same internal family name (MAUI hid that behind per-file
             aliases), which blanked every icon in the app. tabler-solid.ttf is the former
             tabler-icons-filled.ttf with its name table rewritten to "tabler-solid" - the same length,
             so the table did not move. Neither the family names nor the filenames are substrings of
             one another now, which is what both rules above require.
             Codepoints are disjoint: line EA02..10267, solid EE80..101E7. -->
        <FontFamily x:Key="TablerIcons">avares://Floaty/Resources/Fonts/tabler-icons.ttf#tabler-icons</FontFamily>
        <FontFamily x:Key="TablerIconsFilled">avares://Floaty/Resources/Fonts/tabler-solid.ttf#tabler-solid</FontFamily>
    </Application.Resources>

</Application>
