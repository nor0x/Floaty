<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Windows-only for now. The windows TFM keeps every `#if WINDOWS` block compiling unchanged
             and keeps System.Drawing.Common / Interop.UIAutomationClient / XbergIo.Xberg happy. A
             plain `net10.0` TFM gets added back when the macOS (AppKit) head starts - see
             Platforms/MacCatalyst, which is kept in-tree as reference but not compiled. -->
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

        <OutputType>WinExe</OutputType>
        <RootNamespace>Floaty</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>

        <!-- Interop.UIAutomationClient is a COM interop assembly. -->
        <BuiltInComInteropSupport>true</BuiltInComInteropSupport>

        <!-- PerMonitorV2 DPI awareness + longPathAware. MAUI supplied this implicitly; Avalonia needs
             it wired explicitly, and Avalonia's per-monitor scaling depends on it. -->
        <ApplicationManifest>Platforms\Windows\app.manifest</ApplicationManifest>
        <ApplicationIcon>Resources\AppIcon\floaty.ico</ApplicationIcon>

        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

        <!-- Trimming stays off: Markdig, LiteGraph, ONNX Runtime and Xberg all use reflection. -->
        <PublishTrimmed>false</PublishTrimmed>
    </PropertyGroup>

    <ItemGroup>
        <!-- Ring images, built-in sounds and the Tabler icon fonts, addressed at runtime through
             avares:// URIs (see Services/IAppAssets.cs and App.axaml's TablerIcons FontFamily). -->
        <AvaloniaResource Include="Resources\Images\*.png" />
        <AvaloniaResource Include="Resources\Sounds\*.wav" />
        <AvaloniaResource Include="Resources\Fonts\*.ttf" />
        <AvaloniaResource Include="Resources\AppIcon\floaty.ico" />
    </ItemGroup>

    <ItemGroup>
        <!-- Not built. Kept in-tree as reference for the eventual macOS/AppKit head: the KVC +
             objc_msgSend technique in MacOverlayWindowController transfers even though the call
             sites (UIKit's semi-private UIWindow.nsWindow bridge) do not. -->
        <Compile Remove="Platforms\MacCatalyst\**" />
        <Compile Remove="Platforms\iOS\**" />
        <Compile Remove="Platforms\Android\**" />
        <None Include="Platforms\MacCatalyst\**" />

        <!-- MAUI/Blazor UI still on disk while the Avalonia views are written phase by phase. These
             are deleted in Phase 6; until then they stay excluded so the old and new UI can be
             diffed side by side. -->
        <Compile Remove="MauiProgram.cs" />
        <Compile Remove="App.xaml.cs" />
        <Compile Remove="MainPage.xaml.cs" />
        <Compile Remove="OverlayPage.xaml.cs" />
        <Compile Remove="ChatPanelView.xaml.cs" />
        <Compile Remove="ChatWindowPage.xaml.cs" />
        <Compile Remove="SettingsPage.xaml.cs" />
        <Compile Remove="ChatWindowHost.cs" />
        <Compile Remove="VisualElementExtensions.cs" />
        <Compile Remove="Services\ChatSurfaceBridge.cs" />
        <Compile Remove="Components\**" />
        <Compile Remove="Platforms\Windows\App.xaml.cs" />
        <Compile Remove="Platforms\Windows\NativeWindowBinder.cs" />
        <Compile Remove="Platforms\Windows\WindowsTrayIcon.cs" />
        <!-- Replaced by the Avalonia controllers in Phase 2. -->
        <Compile Remove="Platforms\Windows\WindowsBorderlessWindowController.cs" />
        <Compile Remove="Platforms\Windows\WindowsOverlayWindowController.cs" />
        <Compile Remove="Platforms\Windows\WindowsChatWindowController.cs" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Avalonia" Version="12.1.1" />
        <PackageReference Include="Avalonia.Desktop" Version="12.1.1" />
        <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.1" />
        <!-- No Avalonia.Diagnostics: DevTools has no 12.x release (11.3.20 is its last) and is
             not bundled into core, so there is no visual-tree inspector on Avalonia 12 yet. -->
        <!-- Settings only: the overlay and chat panel stay imperative code-behind. -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />

        <!-- The composition root. MAUI supplied this transitively via MauiAppBuilder; Avalonia
             has no builder of its own, so App.axaml.cs references it directly. -->
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />

        <PackageReference Include="AsyncAwaitBestPractices" Version="10.0.0" />
        <!-- Markdown in assistant chat bubbles; see MarkdownRenderer for the deliberately
             restricted pipeline (raw HTML off, no generic attributes, URL scheme allowlist). -->
        <PackageReference Include="Markdig" Version="1.3.2" />

        <!-- AI: provider-agnostic chat abstractions plus the provider bindings AiClientFactory picks
             between. The OpenAI binding does double duty: every OpenAI-compatible endpoint (Gemini,
             OpenRouter, Groq, Ollama, LM Studio, ...) is the same client with a different base URL. -->
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.7.0" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.7.0" />
        <!-- Azure OpenAI: AzureOpenAIClient subclasses OpenAIClient, so it drops into the same path. -->
        <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
        <!-- Anthropic's official C# SDK. It is versioned 10+ but still flagged beta upstream, so
             breaking changes can land in minor releases - keep this pinned. -->
        <PackageReference Include="Anthropic" Version="12.8.0" />

        <!-- Local vector + graph store for capture embeddings (~/.floaty/floaty.db). -->
        <PackageReference Include="LiteGraph" Version="7.0.0" />
        <!-- MCP client (Model Context Protocol). 2.0.0-preview.1 exposes McpClient.CreateAsync +
             McpClientTool : AIFunction, so MCP tools plug into Microsoft.Extensions.AI ChatOptions.Tools. -->
        <PackageReference Include="ModelContextProtocol" Version="2.0.0-preview.1" />
    </ItemGroup>

    <!-- Windows-only: screen-capture dependencies (GDI bitmap encode + UI Automation) for the
         camera button, voice input, on-device embeddings and self-update. WinUIEx is gone with
         MAUI - Avalonia's own Window plus the Win32 interop in Platforms/Windows replaces it. -->
    <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
        <PackageReference Include="System.Drawing.Common" Version="10.0.9" />
        <PackageReference Include="Interop.UIAutomationClient" Version="10.19041.0" />
        <!-- In-app auto-update for the unpackaged Windows build: atomic install/restart plus the
             UpdateManager that reads GitHub Releases. The matching `vpk` CLI packages releases in CI. -->
        <PackageReference Include="Velopack" Version="1.2.0" />
        <!-- Voice input: NAudio captures the mic; onnxruntime runs the Silero VAD that segments
             speech. Transcription itself is transcribe.cpp (GGUF models), whose native runtime is
             downloaded at first use rather than packaged (see NativeRuntimeService). -->
        <PackageReference Include="NAudio" Version="2.2.1" />
        <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.27.1" />
        <!-- On-device embeddings: onnxruntime (above) runs the encoder, Tokenizers turns text into
             WordPiece ids from the model's vocab.txt. Pure managed, no extra native dependency. -->
        <PackageReference Include="Microsoft.ML.Tokenizers" Version="1.0.2" />
        <!-- Text extraction from dropped documents (PDF, Office, e-mail, …). Ships native binaries
             per-RID, so it stays Windows-only; other platforms fall back to NullTextExtractionService
             plus the UTF-8 ladder in FileIngestService. The package is very new, so
             WindowsTextExtractionService treats every failure as "no text" rather than an error.
             Heads-up: xberg_ffi.dll is ~96 MB, which lands in every Velopack full package. -->
        <PackageReference Include="XbergIo.Xberg" Version="1.0.1" />
    </ItemGroup>

</Project>
